#!/usr/bin/env bash
# pre-release gate — unbounded budget. Run before tagging a release.
#
# Generated by wp-harness 0.1.0 (sources/common/hooks/pre-release).
# OWNED file: edits are overwritten by `harness sync`.
#
# Usage: .githooks/pre-release
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

status=0

"$ROOT/bin/harness" lint || status=1

# A plugin carries a test layer; a theme does not (ADR 0009). A theme's
# pre-release is lint, i18n and packaging.
if [[ "plugin" == "plugin" ]]; then
	"$ROOT/bin/harness" test || status=1

	if [[ -d "$ROOT/tests/Integration" ]]; then
		"$ROOT/bin/harness" integration || status=1
	fi
fi

"$ROOT/bin/harness" pot || status=1
"$ROOT/bin/harness" package || status=1

if [[ "plugin" == "plugin" ]]; then
	"$ROOT/bin/harness" pcp || status=1
fi

if [[ $status -ne 0 ]]; then
	printf '\npre-release failed. Do not tag.\n' >&2
fi
exit $status
