#!/usr/bin/env bash
# pre-commit gate — budget < 10 s, so it runs on staged files only.
#
# Generated by wp-harness 0.1.0 (sources/common/hooks/pre-commit).
# OWNED file: edits are overwritten by `harness sync`.
#
# Bypassing this with --no-verify is a hard rule violation, not a convenience.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# The budget below is a target, and the hook reports what it actually cost. A
# gate that silently misses its own budget is a gate whose budget is decoration.
BUDGET=10
SECONDS=0

if [[ ! -x "$ROOT/bin/harness" ]]; then
	printf 'pre-commit: bin/harness is missing or not executable.\n' >&2
	printf 'Run `harness sync` from the generator checkout, or restore the file.\n' >&2
	exit 1
fi

mapfile -t STAGED < <(git diff --cached --name-only --diff-filter=ACMR)
if [[ ${#STAGED[@]} -eq 0 ]]; then
	exit 0
fi

PHP_FILES=()
TEST_FILES=()
JS_FILES=()
CSS_FILES=()

# Which staged front-end files are linted.
#
# The generated `npm run lint` and `npm run lint:css` glob the asset roots
# (assets/src) and never see a vendored library under
# `assets/lib/`, an icon font under `assets/fonts/`, or the theme `style.css`.
# This hook did see them -- it lints whatever is staged -- so a reformatted
# vendor file passed `npm run lint:css` and failed the commit. That is the same
# defect class as handing build output to ESLint: a file one gate does not judge
# and another does. Test sources stay in scope, because nothing else lints them.
_in_front_end_scope() {
	local file="$1" dir
	case "$file" in
	tests/*) return 0 ;;
	esac
	for dir in assets/src; do
		case "$file" in
		"$dir"/*) return 0 ;;
		esac
	done
	return 1
}

for file in "${STAGED[@]}"; do
	[[ -f "$file" ]] || continue
	# Generated output is committed, so it is staged, so it arrives here -- and
	# both linters ignore it, so ESLint emits "File ignored because of a matching
	# ignore pattern" as a *warning*, on every commit, for every artefact.
	# `--max-warnings=0` turns that into a failure in `npm run lint`.
	#
	# Build output is checked by the build, not by a linter. Skipping it here
	# keeps the hook reporting on the source it is meant to report on.
	case "$file" in
	assets/build/* | node_modules/* | vendor/* | .cache/*) continue ;;
	esac
	case "$file" in
	*.php)
		PHP_FILES+=("$file")
		[[ "$file" == tests/* ]] && TEST_FILES+=("$file")
		;;
	*.js | *.jsx | *.ts | *.tsx)
		if _in_front_end_scope "$file"; then JS_FILES+=("$file"); fi
		;;
	*.scss | *.css)
		if _in_front_end_scope "$file"; then CSS_FILES+=("$file"); fi
		;;
	esac
done

status=0

# A plugin carries a test layer; a theme does not (ADR 0009). The anti-pattern
# scan is part of that layer, so a theme does not run it. The kind is baked into
# this hook rather than asked of the runtime: `bin/harness suite` prints a
# sentence for a theme and returns success, and capturing that sentence into
# `$SUITE` below would run it as a command.
if [[ "plugin" == "plugin" && ${#TEST_FILES[@]} -gt 0 ]]; then
	"$ROOT/bin/harness" antipatterns "${TEST_FILES[@]}" || status=1
fi

if [[ ${#PHP_FILES[@]} -gt 0 ]]; then
	"$ROOT/bin/harness" lint:files "${PHP_FILES[@]}" || status=1
fi

if [[ ${#JS_FILES[@]} -gt 0 ]]; then
	"$ROOT/bin/harness" exec npx wp-scripts lint-js -- "${JS_FILES[@]}" || status=1
fi

if [[ ${#CSS_FILES[@]} -gt 0 ]]; then
	"$ROOT/bin/harness" exec npx wp-scripts lint-style -- "${CSS_FILES[@]}" || status=1
fi

# Behaviour check: only for a plugin, only when PHP changed, and only the fast
# suite — pre-commit carries a budget, and a project whose tests are all
# integration has no unit suite to run here. `test` against one fails on the
# empty-suite guard, which reports a red build for a project whose tests are
# fine. A theme carries no test layer at all (ADR 0009).
if [[ "plugin" == "plugin" && ${#PHP_FILES[@]} -gt 0 && "${HARNESS_SKIP_TESTS:-0}" != "1" ]]; then
	SUITE="$("$ROOT/bin/harness" suite)" || SUITE="test"
	if [[ "$SUITE" == "integration" ]]; then
		printf 'pre-commit: no unit suite — run bin/harness integration before pushing.\n' >&2
	else
		"$ROOT/bin/harness" "$SUITE" || status=1
	fi
fi

# The code graph, before the commit rather than at the next query.
#
# `ensure` builds only when there is nothing to read, so on a checkout that has
# ever answered a graft query this is a no-op and the 10 s budget is untouched.
# On one that has never been asked, it makes the graph exist — and that is the
# failure worth spending the gate on: `graft ask` with no graph answers "no
# matching nodes — try different words" and exits 0, so an agent reads a missing
# index as a bad question and goes back to reading whole files.
#
# PHP or JS only. The graph indexes code; a commit that touches neither cannot
# have changed what it describes.
if [[ ${#PHP_FILES[@]} -gt 0 || ${#JS_FILES[@]} -gt 0 ]]; then
	"$ROOT/bin/harness" graft ensure || status=1
fi

if [[ $status -ne 0 ]]; then
	printf '\npre-commit failed after %ss (target %ss). Fix the findings above,\n' "$SECONDS" "$BUDGET" >&2
	printf 'or state explicitly why the gate is wrong.\n' >&2
elif [[ $SECONDS -gt $BUDGET ]]; then
	printf '\npre-commit passed in %ss, over the %ss target. See docs/ in the\n' "$SECONDS" "$BUDGET" >&2
	printf 'generator checkout before moving this suite out of the fast gate.\n' >&2
fi
exit $status
