#!/usr/bin/env bash
# pre-push gate — budget < 90 s. The full correctness gate before code leaves
# the machine. Mutation testing is scoped to the diff so the budget holds.
#
# Generated by wp-harness 0.1.0 (sources/common/hooks/pre-push).
# OWNED file: edits are overwritten by `harness sync`.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

status=0

"$ROOT/bin/harness" lint || status=1

# A plugin carries a test layer; a theme does not (ADR 0009). A theme's pre-push
# is the full lint and nothing more. The kind is baked into the hook rather than
# asked of the runtime, because `bin/harness suite` prints a sentence for a
# theme and `$SUITE` would then hold that sentence.
if [[ "plugin" == "plugin" ]]; then
	# The suite this project has, not the suite a plugin "should" have: with
	# only integration tests, running `test` fails on the empty-suite guard and
	# reports a red build for a project whose tests are fine.
	SUITE="$("$ROOT/bin/harness" suite)" || SUITE="test"
	"$ROOT/bin/harness" "$SUITE" || status=1

	if [[ -f "$ROOT/infection.json5" || -f "$ROOT/infection.json" ]]; then
		"$ROOT/bin/harness" mutation || status=1
	else
		printf 'pre-push: mutation testing not wired (no infection config).\n' >&2
		printf '  Tests that cannot fail are worse than no tests. See DESIGN.md section 5.\n' >&2
		if [[ "${HARNESS_REQUIRE_MUTATION:-1}" == "1" ]]; then
			status=1
		fi
	fi

	# Infection builds mutants for class methods only — `ReflectionVisitor`
	# returns early when no class is in scope — so it sees nothing in a project
	# written as global functions. This is the same question asked of the lines
	# the suite executes, and for those projects it is the gate rather than a
	# supplement.
	"$ROOT/bin/harness" counterfactual || status=1
fi

if [[ $status -ne 0 ]]; then
	printf '\npre-push failed. Push with --no-verify only if the gate itself is broken,\n' >&2
	printf 'and say so out loud when you do.\n' >&2
fi
exit $status
