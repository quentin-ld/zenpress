#!/usr/bin/env bash
# pre-push gate — budget < 480 s, and the number is a measurement rather than a
# wish: this hook read "< 90 s" for as long as it existed and nothing checked
# it. The full correctness gate before code leaves the machine. Mutation testing
# is scoped to the diff so the budget holds.
#
# Generated by wp-harness 0.1.0 (sources/common/hooks/pre-push).
# OWNED file: edits are overwritten by `harness sync`.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# The budget, reported the way `pre-commit` reports its 10 s: on the way out,
# against what the run actually cost.
#
# Measured by running this hook, on a clean tree, in the fleet's two slowest
# projects:
#
#   updatronix       130 s
#   updatronix-pro   421 s
#
# A theme costs 6-10 s. Both plugins' figures are dominated by their two
# diff-scoped stages — `mutation` runs the project's suite once per mutant on
# the changed lines, and `counterfactual` runs the covering tests once per
# substitution — and both read the diff against `origin/HEAD`, which in this
# fleet resolves to `origin/main`, so they judge the whole branch rather than
# the push. That is where the seconds are, and it is why the number is minutes
# rather than the 90 s that was written there.
#
# One budget has to hold for thirteen projects, so the target is the fleet's
# slowest, rounded up: the two large stages scale with the diff, and two runs of
# the same gate a few minutes apart measured 384 s and 421 s, so a target set at
# the measurement itself would report an overrun every other push.
#
# It is a target, not a limit. The hook reports the overrun and does not fail on
# it; what it must not do is state a number nobody has ever checked.
BUDGET=480
SECONDS=0

status=0

"$ROOT/bin/harness" lint || status=1

# A plugin carries a test layer; a theme does not (ADR 0009). A theme's pre-push
# is the full lint and nothing more. The kind is baked into the hook rather than
# asked of the runtime, because `bin/harness suite` prints a sentence for a
# theme and `$SUITE` would then hold that sentence.
if [[ "plugin" == "plugin" ]]; then
	# The suite this project has, not the suite a plugin "should" have: with
	# only integration tests, running `test` fails on the empty-suite guard and
	# reports a red build for a project whose tests are fine.
	SUITE="$("$ROOT/bin/harness" suite)" || SUITE="test"
	"$ROOT/bin/harness" "$SUITE" || status=1

	if [[ -f "$ROOT/infection.json5" || -f "$ROOT/infection.json" ]]; then
		"$ROOT/bin/harness" mutation || status=1
	else
		printf 'pre-push: mutation testing not wired (no infection config).\n' >&2
		printf '  Tests that cannot fail are worse than no tests. See DESIGN.md section 5.\n' >&2
		if [[ "${HARNESS_REQUIRE_MUTATION:-1}" == "1" ]]; then
			status=1
		fi
	fi

	# Infection builds mutants for class methods only — `ReflectionVisitor`
	# returns early when no class is in scope — so it sees nothing in a project
	# written as global functions. This is the same question asked of the lines
	# the suite executes, and for those projects it is the gate rather than a
	# supplement.
	"$ROOT/bin/harness" counterfactual || status=1
fi

if [[ $status -ne 0 ]]; then
	printf '\npre-push failed after %ss (target %ss). Fix the findings above,\n' \
		"$SECONDS" "$BUDGET" >&2
	printf 'or state explicitly why the gate is wrong.\n' >&2
	printf 'Push with --no-verify only if the gate itself is broken, and say so out\n' >&2
	printf 'loud when you do.\n' >&2
elif [[ $SECONDS -gt $BUDGET ]]; then
	printf '\npre-push passed in %ss, over the %ss target. The budget is a\n' \
		"$SECONDS" "$BUDGET" >&2
	printf 'measurement rather than a limit; before changing it, measure which stage\n' >&2
	printf 'cost the time and whether that stage can be narrowed. `bin/harness\n' >&2
	printf 'counterfactual` prints how many substitutions it answered with the\n' >&2
	printf 'covering tests alone, which is where one such change came from.\n' >&2
	printf 'See docs/TOOLCHAIN.md, "Raising the floor".\n' >&2
else
	# Printed on a passing run too, which is where this departs from
	# `pre-commit`. That hook stays quiet inside its budget, and a budget
	# nobody ever sees is how "< 90 s" survived in this file while the fleet
	# spent four times it. One line per push is the whole measurement.
	printf '\npre-push passed in %ss (target %ss).\n' "$SECONDS" "$BUDGET" >&2
fi
exit $status
