#!/usr/bin/env bash
# ZenPress — harness runner.
#
# Generated by wp-harness 0.1.0 (sources/common/runtime/bin__harness).
# This file is OWNED: hand edits are overwritten by `harness sync`.
#
# Self-contained on purpose. A developer who clones this repository alone gets a
# working toolchain with no extra install — no Python, no Node, no global CLI.
# See AGENTS.md for the contracts this enforces.
#
# Backend order: DDEV, then LocalWP, then the host. The host is never used
# implicitly when a project backend exists, because a host toolchain and a
# container toolchain disagree about PHP versions in ways that are expensive to
# debug.
set -euo pipefail

HARNESS_VERSION="0.1.0"
PROJECT_SLUG="zenpress"
PROJECT_KIND="plugin"
PROJECT_TEXT_DOMAIN="zenpress"
PROJECT_MAIN_FILE="zenpress.php"
PROJECT_PHP_MIN="8.1"
PROJECT_SOURCE_DIRS="inc"
PROJECT_ASSET_DIRS="assets/src"

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECT_REL=""
WP_ROOT=""
LOCAL_SITE_SHELL=""

# ---------------------------------------------------------------------------
# environment
# ---------------------------------------------------------------------------

_find_wp_root() {
	local dir="$PROJECT_ROOT"
	while [[ "$dir" != "/" ]]; do
		if [[ -f "$dir/wp-load.php" ]]; then
			printf '%s' "$dir"
			return 0
		fi
		dir="$(dirname "$dir")"
	done
	return 1
}

# LocalWP is a compatibility floor, not a second implementation. Only the
# documented "Site Shell" environment file is supported: Local writes one into
# ~/.config/Local/ssh-entry/ the first time a site's shell is opened, and it
# carries the exports that put Local's PHP, MySQL and WP-CLI on PATH.
#
# The hand-written `.config/local-wp-cli.sh` resolved this from
# `~/.config/Local/sites.json` with an embedded Python helper. Bash cannot parse
# JSON without a dependency and this runtime is required to run with none, so
# the entry is located by matching the `cd` line it already contains against the
# WordPress root. `LOCAL_SITE_SHELL` still overrides.
_find_local_shell() {
	if [[ -n "${LOCAL_SITE_SHELL:-}" && -f "${LOCAL_SITE_SHELL}" ]]; then
		printf '%s' "$LOCAL_SITE_SHELL"
		return 0
	fi

	local entry cd_path
	for entry in "${HOME}"/.config/Local/ssh-entry/*.sh; do
		[[ -f "$entry" ]] || continue
		cd_path="$(sed -n 's/^cd "\(.*\)"$/\1/p' "$entry" | head -1)"
		[[ -n "$cd_path" ]] || continue
		if [[ "$(cd "$cd_path" 2>/dev/null && pwd -P)" == "$WP_ROOT" ]]; then
			printf '%s' "$entry"
			return 0
		fi
	done
	return 1
}

detect_backend() {
	if [[ -n "${HARNESS_BACKEND:-}" ]]; then
		printf '%s' "$HARNESS_BACKEND"
		return 0
	fi

	# Already inside the web container. DDEV sets IS_DDEV_PROJECT there, and it
	# is the one reliable signal: `ddev` is on PATH inside the container too, so
	# without this check the runtime nests a second `ddev exec` and DDEV answers
	#   "You executed 'ddev exec …' inside the web container but many DDEV
	#    commands are not available."
	# Reached by any composer script that calls back into this runner, which is
	# exactly what `"test": "bash bin/harness test"` does.
	if [[ -n "${IS_DDEV_PROJECT:-}" ]]; then
		printf 'host'
		return 0
	fi

	if [[ -f "$WP_ROOT/.ddev/config.yaml" ]] && command -v ddev >/dev/null 2>&1; then
		if (cd "$WP_ROOT" && ddev exec -- true >/dev/null 2>&1); then
			printf 'ddev'
			return 0
		fi
		warn "DDEV project detected but not running — treating the host as fallback."
		warn "Start it with: cd ${WP_ROOT} && ddev start"
	fi
	if [[ -n "$LOCAL_SITE_SHELL" && -f "$LOCAL_SITE_SHELL" ]]; then
		printf 'local'
		return 0
	fi
	printf 'host'
}

_init() {
	WP_ROOT="$(_find_wp_root || true)"
	if [[ -z "$WP_ROOT" ]]; then
		WP_ROOT="$PROJECT_ROOT"
	fi
	if [[ "$PROJECT_ROOT" == "$WP_ROOT" ]]; then
		PROJECT_REL="."
	else
		PROJECT_REL="${PROJECT_ROOT#"$WP_ROOT"/}"
	fi
	# Where the project sits inside the web container. DDEV's `--dir` wants an
	# absolute path, and stating it lets every command run with the project as
	# its working directory instead of being wrapped in `cd … && …`.
	PROJECT_CONTAINER_DIR="/var/www/html/${PROJECT_REL}"

	LOCAL_SITE_SHELL="$(_find_local_shell || true)"
	BACKEND="$(detect_backend)"
}

warn() { printf '\033[33m%s\033[0m\n' "$*" >&2; }
fail() { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }
info() { printf '\033[2m%s\033[0m\n' "$*"; }
step() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }

# ---------------------------------------------------------------------------
# backends
# ---------------------------------------------------------------------------
# Two DDEV flags, both load-bearing, both discovered by a command failing for a
# reason that had nothing to do with the command.
#
# `-q` — without it, `ddev exec` prints
#   Failed to execute command `bash -lc "…"`: exit status 1
# whenever the wrapped command exits non-zero, which is exactly what a gate does
# when it finds something. A legitimate "your test is weak" failure read as
# "your environment is broken".
#
# `--raw` — the help text says "default true", and it is not. Without it DDEV
# re-parses the command through its own bash, which still has `nounset` and
# `errexit` on: `echo "${DEFINITELY_UNSET}"` failed with "unbound variable", a
# `$-` in our own string reported DDEV's shell options rather than ours, and
# `set +u` inside the command had no effect because the expansion had already
# happened in the wrapper. Sources of shell variables read as broken files.
# Verified: with `--raw`, `$-` is a clean `hBc` and the same command works.

_ddev_exec() {
	(cd "$WP_ROOT" && ddev exec -q --raw -d "$PROJECT_CONTAINER_DIR" -- "$@")
}

# The Site Shell file ends with `exec $SHELL`. Sourcing it raw replaces this
# process with an interactive shell, so every command after it silently does
# nothing — the LocalWP backend looked like it worked and ran nothing at all.
# Only the lines that set up the environment are kept: the exports, the `cd`,
# and the NODE_ENV unset. The hand-written `.config/local-wp-cli.sh` filtered
# the file the same way; this is that behaviour, carried over.
_source_local_shell() {
	[[ -f "$LOCAL_SITE_SHELL" ]] || return 0
	# shellcheck disable=SC1090
	source <(awk '/^export / { print } /^cd "/ { print } /^unset NODE_ENV$/ { print }' "$LOCAL_SITE_SHELL")
}

_local_exec() {
	_source_local_shell
	local command
	command="$(printf '%q ' "$@")"
	(cd "$PROJECT_ROOT" && eval "$command")
}

_host_exec() {
	(cd "$PROJECT_ROOT" && "$@")
}

run() {
	case "$BACKEND" in
	ddev) _ddev_exec "$@" ;;
	local) _local_exec "$@" ;;
	host) _host_exec "$@" ;;
	*) fail "unknown backend: $BACKEND" ;;
	esac
}

# Shell-interpreting variant, for probes and pipelines. `run` passes argv
# straight through with no shell, so `php -m | grep x` must come here.
run_sh() {
	case "$BACKEND" in
	ddev) (cd "$WP_ROOT" && ddev exec -q --raw -d "$PROJECT_CONTAINER_DIR" -- bash -lc "$1") ;;
	local)
		_source_local_shell
		(cd "$PROJECT_ROOT" && bash -lc "$1")
		;;
	host) (cd "$PROJECT_ROOT" && bash -lc "$1") ;;
	esac
}

has_tool() {
	run_sh "command -v $(printf '%q' "$1") >/dev/null 2>&1"
}

require_tool() {
	if ! has_tool "$1"; then
		fail "'$1' is not available in the '$BACKEND' backend.
  DDEV:   add it to .ddev/web-build/Dockerfile or a .ddev/commands file.
  LocalWP: use the Site Shell binary that ships it."
	fi
}

# ---------------------------------------------------------------------------
# graft — the one tool that deliberately does NOT run in the container
# ---------------------------------------------------------------------------

# graft is an nvm-installed Node binary. An agent whose shell never sourced nvm
# cannot see it, so we resolve the newest nvm Node explicitly instead of
# trusting PATH.
_resolve_graft() {
	if command -v graft >/dev/null 2>&1; then
		command -v graft
		return 0
	fi
	local candidate
	candidate="$(ls -1d "${HOME}"/.nvm/versions/node/*/bin/graft 2>/dev/null | sort -V | tail -1 || true)"
	if [[ -n "$candidate" && -x "$candidate" ]]; then
		printf '%s' "$candidate"
		return 0
	fi
	return 1
}

cmd_graft() {
	local bin
	if ! bin="$(_resolve_graft)"; then
		fail "graft not found. Install it with the Node toolchain (nvm), or add it to PATH."
	fi
	# Do not pre-build when the caller is already building: that ran the whole
	# index twice on the first invocation.
	if [[ "${1:-}" != "build" && ! -d "$PROJECT_ROOT/graft" ]]; then
		info "no graft index yet — building one (first run only)"
		(cd "$PROJECT_ROOT" && "$bin" build)
	fi
	(cd "$PROJECT_ROOT" && "$bin" "$@")
}

# ---------------------------------------------------------------------------
# gates
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# tool configuration
# ---------------------------------------------------------------------------
# Every tool is invoked through its vendored binary, with a probed config path.
#
# Delegating to `composer run <script>` was the first design and it broke on the
# first real run: `"test": "phpunit --configuration=…"` resolves only because
# LocalWP's Site Shell put `phpunit` on PATH. Under DDEV there is no such
# binary, so the project's own contract fails for a reason that has nothing to
# do with the project. A runtime that only works under one backend is the
# coupling this harness exists to remove.
#
# The other reason is a cycle: the projects are converging on `bin/harness` as
# the entry point, so a composer script will eventually call back into here.
# Calling it from here would be infinite recursion.

_find_file() {
	local candidate
	for candidate in "$@"; do
		if [[ -f "$PROJECT_ROOT/$candidate" ]]; then
			printf '%s' "$candidate"
			return 0
		fi
	done
	return 1
}

_require_config() {
	local label="$1"
	shift
	local found
	if ! found="$(_find_file "$@")"; then
		fail "no $label configuration in ${PROJECT_SLUG}. Looked for: $*"
	fi
	printf '%s' "$found"
}

# A project whose tests are all integration tests has no unit suite, and one
# whose tests are all unit tests has no integration suite. Both are complete
# projects, and the gate that decides is the pre-push one — `bin/harness suite`
# — which runs whichever the project has.
#
# So a missing suite is an error only when there is no suite at all. Failing on
# either instead made `npm run test:all` unsatisfiable for two themes and for
# the Pro plugin, and a gate nobody can pass is a gate everybody ignores.
# Nothing is skipped quietly: the note names the suite that does exist.
_missing_suite_note() {
	local missing="$1" existing="$2"
	info "${PROJECT_SLUG} has no ${missing} suite; its tests are ${existing} tests."
	info "Nothing is skipped: bin/harness ${existing}, or bin/harness suite."
}

# A plugin carries a test layer; a theme does not. ADR 0009.
#
# This is the one place the runtime says it. Nine callers ask: `test`,
# `integration`, `suite`, `coverage`, `mutation`, `counterfactual`, `test:js`,
# `e2e`, and `setup`'s test-stack step. Each prints this one sentence and
# returns success, because a gate that fails for the sole reason that a decision
# removed its subject is a gate people turn off -- and it would read as a broken
# project rather than a deliberate one.
#
# The hooks do NOT ask it. They branch on `PROJECT_KIND`, rendered into the
# hook, because a hook that captured this sentence into `$SUITE` and ran the
# result would try to execute the sentence as a command.
_require_test_layer() {
	[[ "$PROJECT_KIND" == "plugin" ]] && return 0
	info "${PROJECT_SLUG} is a theme: the harness carries no test layer for themes, so there is nothing to run here (ADR 0009)."
	return 1
}

_require_binary() {
	local binary="$1" package="$2"
	if [[ ! -x "$PROJECT_ROOT/vendor/bin/$binary" ]]; then
		fail "vendor/bin/$binary is missing. Install it with:
  bin/harness composer require --dev $package"
	fi
}

# Paths to hand PHPStan: the bootstrap file, the uninstaller, and every
# top-level source directory the generator derived from the project layout.
# The paths a gate should look at: root-level PHP, the derived source
# directories, and nothing else.
#
# `PROJECT_SOURCE_DIRS` comes from *subdirectories*, and a WordPress theme keeps
# `functions.php`, `header.php`, `index.php` and friends at the root — so a
# theme's most important file was never linted, never analysed, and never in the
# diff the anti-tautology gate reads. Verified: holidayinarles-theme resolved to
# `inc template-parts` and nothing else.
#
# `PROJECT_MAIN_FILE` does not cover it either. For a plugin that is the plugin
# file; for a theme it is `style.css`, which is the theme's identity rather than
# its code, and handing it to PHP_CodeSniffer lints a stylesheet.
#
# Shared by lint, phpstan and counterfactual so the three cannot disagree about
# what the project is made of.
_code_paths() {
	local paths=() file dir
	if [[ "$PROJECT_MAIN_FILE" == *.php && -f "$PROJECT_ROOT/$PROJECT_MAIN_FILE" ]]; then
		paths+=("$PROJECT_MAIN_FILE")
	fi
	[[ -f "$PROJECT_ROOT/uninstall.php" ]] && paths+=("uninstall.php")
	for file in "$PROJECT_ROOT"/*.php; do
		[[ -f "$file" ]] || continue
		file="$(basename "$file")"
		[[ " ${paths[*]-} " == *" $file "* ]] && continue
		paths+=("$file")
	done
	for dir in $PROJECT_SOURCE_DIRS; do
		paths+=("$dir")
	done
	if [[ ${#paths[@]} -eq 0 ]]; then
		paths=(".")
	fi
	printf '%s\n' "${paths[@]}"
}

_phpstan_paths() {
	_code_paths
}

# Paths to hand PHP_CodeSniffer: the code, plus the test tree when there is one.
# The generated ruleset carries no <file> list on purpose — a project that adds
# `src/` next year should not also need `.config/phpcs.xml` edited.
_lint_paths() {
	_code_paths
	# Test *code*, not test scaffolding. The hand-written ruleset this replaced
	# listed `tests/Unit/` and `tests/Integration/` and nothing else, and adding
	# `tests/` wholesale pulled in `tests/stubs/` — WordPress doubles, not plugin
	# code, which then failed the gate with indentation errors.
	local dir
	for dir in tests/Unit tests/Integration; do
		[[ -d "$PROJECT_ROOT/$dir" ]] && printf '%s\n' "$dir"
	done
}

cmd_lint_wpcs() {
	local config
	config="$(_require_config 'PHP_CodeSniffer' .config/phpcs.xml phpcs.xml phpcs.xml.dist)"
	_require_binary phpcs squizlabs/php_codesniffer
	step "WPCS (${config})"
	local -a targets=()
	while IFS= read -r line; do
		[[ -n "$line" ]] && targets+=("$line")
	done < <(_lint_paths)
	run vendor/bin/phpcs --standard="$config" "${targets[@]}"
}

cmd_lint() {
	local phpcs_config phpstan_config
	phpcs_config="$(_require_config 'PHP_CodeSniffer' .config/phpcs.xml phpcs.xml phpcs.xml.dist)"
	phpstan_config="$(_require_config 'PHPStan' .config/phpstan.neon phpstan.neon phpstan.neon.dist)"
	_require_binary phpcs squizlabs/php_codesniffer
	_require_binary phpstan phpstan/phpstan

	step "WPCS (${phpcs_config})"
	local -a lint_targets=()
	while IFS= read -r line; do
		[[ -n "$line" ]] && lint_targets+=("$line")
	done < <(_lint_paths)
	run vendor/bin/phpcs --standard="$phpcs_config" "${lint_targets[@]}"

	step "PHPStan (${phpstan_config})"
	local -a targets=()
	while IFS= read -r line; do
		[[ -n "$line" ]] && targets+=("$line")
	done < <(_phpstan_paths)
	run vendor/bin/phpstan analyse --memory-limit=2048M \
		--configuration="$phpstan_config" "${targets[@]}"
}

cmd_lint_fix() {
	local phpcs_config
	phpcs_config="$(_require_config 'PHP_CodeSniffer' .config/phpcs.xml phpcs.xml phpcs.xml.dist)"
	_require_binary phpcbf squizlabs/php_codesniffer
	step "WPCS autofix (${phpcs_config})"
	# The same paths as the check. Without them phpcbf falls back to the
	# ruleset's <file> list, which the generated ruleset deliberately does not
	# have, so it silently fixed nothing.
	local -a targets=()
	while IFS= read -r line; do
		[[ -n "$line" ]] && targets+=("$line")
	done < <(_lint_paths)
	run vendor/bin/phpcbf --standard="$phpcs_config" "${targets[@]}" || true
}

cmd_lint_files() {
	# Staged-file lint for the pre-commit budget. Paths are relative to the
	# project root, which is where every backend lands.
	[[ $# -gt 0 ]] || return 0
	local phpcs_config
	phpcs_config="$(_require_config 'PHP_CodeSniffer' .config/phpcs.xml phpcs.xml phpcs.xml.dist)"
	_require_binary phpcs squizlabs/php_codesniffer
	step "WPCS (${#} file(s))"
	run vendor/bin/phpcs --standard="$phpcs_config" "$@"
}

cmd_test_js() {
	_require_test_layer || return 0
	step "JS unit tests (Vitest via @wordpress/scripts)"

	# Jest ships inside @wordpress/scripts, so a project with JS tests needs no
	# dependency of its own.
	#
	# A project without them is not failing: say so, as the PHP side does for a
	# missing suite. And no `--passWithNoTests` -- a directory with no test file
	# in it should say so rather than report a green run over nothing, which is
	# the same tautology the PHP gates ban.
	if [[ ! -d "$PROJECT_ROOT/tests/js" ]]; then
		info "${PROJECT_SLUG} has no JS tests; tests/js/ does not exist."
		return 0
	fi

	# Vitest, which is what `wp-scripts` uses now. It resolves the runner from
	# the project and passes `--watch=false`, so a run is a run.
	#
	# The fleet is aligned on `@wordpress/scripts` 36 and on Vitest; there is no
	# Jest anywhere. Carrying both meant carrying two configs, two dependency
	# sets, and a command that worked for only one generation of the tooling.
	#
	# The `--config` path is relative, on purpose. Every backend lands with the
	# project as its working directory — `_ddev_exec` passes
	# `-d "$PROJECT_CONTAINER_DIR"`, and both fallbacks `cd "$PROJECT_ROOT"` —
	# so a path is valid there. A host-absolute `"$PROJECT_ROOT/…"` is not: it
	# was the one `run` call in this file that handed `ddev exec` a path that
	# only exists on the host, and Vite answered with
	# `Cannot resolve entry module ../../…/tests/js/vitest.config.js`.
	run npx wp-scripts test-unit-js --config tests/js/vitest.config.js
}

cmd_antipatterns() {
	step "Anti-tautology scan"
	run php bin/check-test-antipatterns.php "$@"
}

# Reports, never fails. A prose-only diff is worth a second look -- was the
# comment wrong, or was it reflowed? -- and a gate that fires wrongly inside a
# hook is a gate people route around.
cmd_prose() {
	step "Prose drift (comments without code)"
	run php bin/check-prose-drift.php "$@"
}

# The three front-end gates, which run `wp-scripts` through the scripts the
# harness generates into `package.json`.
#
# They go through the scripts rather than calling `npx wp-scripts` here because
# a developer on this project types `npm run lint`, and a gate that runs
# something else verifies something else. The generated scripts carry no
# `--config`; before this, five projects pointed theirs at a private ESLint or
# Stylelint config, and the weakest of those reported 649 problems where the
# WordPress preset reports 650. A project was free to lint itself with a looser
# ruleset than the fleet's, and two did.
#
# `--max-warnings=0` is in the scripts, so a warning is a failure rather than a
# line of output nobody reads.
_require_frontend() {
	if [[ -z "$PROJECT_ASSET_DIRS" ]]; then
		info "${PROJECT_SLUG} has no front-end sources; skipping."
		return 1
	fi
	if [[ ! -d "$PROJECT_ROOT/node_modules" ]]; then
		fail "no node_modules. Install the toolchain first: (cd ${PROJECT_REL} && npm install)"
	fi
	return 0
}

cmd_lint_js() {
	_require_frontend || return 0
	step "ESLint (WordPress preset, warnings fail)"
	run npm run lint
}

cmd_lint_css() {
	_require_frontend || return 0
	step "Stylelint (WordPress preset, warnings fail)"
	run npm run lint:css
}

cmd_format() {
	_require_frontend || return 0
	step "Prettier (WordPress preset)"
	# This one writes. `@wordpress/scripts/scripts/format.js` passes `--write` to
	# Prettier unconditionally and takes no `--check`, so there is no way to ask
	# it whether the tree is formatted -- which is why it is not in the pre-push
	# gate and does not need to be. `@wordpress/eslint-plugin` runs
	# `prettier/prettier` as an error, so `npm run lint` already fails on
	# unformatted code: 649 of the 650 problems the native config found in
	# zenpress were exactly that rule. This command is the fixer, not the check.
	run npm run format
}

# The test directories a PHPUnit config declares, resolved from that config's
# own directory.
#
# `<directory>` is relative to the config file, not to the project — `.config`
# holds `<directory>../tests/Unit</directory>`, which means `tests/Unit`. Read
# from the project root it means `wp-content/plugins/tests/Unit`, which does not
# exist, so the guard counted zero tests in a suite that has 194 of them. It
# happened to give the right answer for zenpress, whose unit suite really is
# empty, which is exactly how this kind of bug survives a check.
_suite_dirs() {
	local config_dir
	config_dir="$(dirname "$1")"
	while read -r dir; do
		[[ -n "$dir" ]] || continue
		printf '%s\n' "${config_dir}/${dir}"
	done < <(sed -n 's:.*<directory[^>]*>\([^<]*\)</directory>.*:\1:p' "$PROJECT_ROOT/$1" 2>/dev/null || true)
}

# The PHPUnit config whose declared directories actually contain tests.
#
# Not "the first config that exists". This fleet keeps the unit and integration
# configs side by side in `.config/`, and a project whose tests are all
# integration still has a valid unit config — one that points at a directory
# that does not exist. A lookup by filename picks it every time. That mistake
# has been made twice in this repository: once in the empty-suite guard below,
# and once when Infection was pointed at the integration suite.
_config_with_tests() {
	local candidate dir count total
	for candidate in "$@"; do
		[[ -f "$PROJECT_ROOT/$candidate" ]] || continue
		total=0
		while read -r dir; do
			[[ -n "$dir" ]] || continue
			count="$(run_sh "find ${dir@Q} -name '*Test.php' 2>/dev/null | wc -l" | tr -d '[:space:]')"
			total=$(( total + ${count:-0} ))
		done < <(_suite_dirs "$candidate")
		if [[ "$total" -gt 0 ]]; then
			printf '%s' "$candidate"
			return 0
		fi
	done
	return 1
}

cmd_test() {
	_require_test_layer || return 0
	local config
	if ! config="$(_find_file .config/phpunit.xml.dist .config/phpunit.xml phpunit.xml.dist phpunit.xml)"; then
		if _find_file .config/phpunit.integration.xml.dist .config/phpunit.integration.xml phpunit.integration.xml.dist >/dev/null; then
			_missing_suite_note "unit" "integration"
			return 0
		fi
		fail "no PHPUnit suite wired for ${PROJECT_SLUG}.
  Neither a unit config nor an integration one exists. Looked for:
    .config/phpunit.xml.dist and .config/phpunit.integration.xml.dist"
	fi
	_require_binary phpunit phpunit/phpunit
	# A configured suite with no test files reports OK, which is
	# indistinguishable from a suite that passes. This is the tautology the rest
	# of these gates exist to catch, one level up — and PHPUnit 9 has no
	# `--fail-on-empty-test-suite` to catch it for us.
	#
	# Counted inside the directories the config declares, not across the
	# project. Counting project-wide let a project satisfy this guard with its
	# integration tests while its unit config pointed at a directory that did
	# not exist, so PHPUnit died with "Test directory not found" — which reads
	# as a broken setup rather than as the empty suite it actually is.
	local suite_dirs=""
	local test_files=0
	local dir count
	while read -r dir; do
		[[ -n "$dir" ]] || continue
		suite_dirs="${suite_dirs}${suite_dirs:+, }${dir}"
		count="$(run_sh "find ${dir@Q} -name '*Test.php' 2>/dev/null | wc -l" | tr -d '[:space:]')"
		test_files=$(( test_files + ${count:-0} ))
	done < <(_suite_dirs "$config")

	if [[ "${test_files:-0}" -eq 0 ]]; then
		fail "${PROJECT_SLUG} declares a PHPUnit suite but it contains no *Test.php file.
  ${config} points at: ${suite_dirs:-the project}
  A suite that runs nothing reports OK, so this gate would pass forever
  without testing anything. Add tests, or remove the suite configuration."
	fi

	step "Unit tests (${config}, ${test_files} test file(s))"
	# --no-coverage because the gate is correctness, not instrumentation: the
	# config declares coverage, so PHPUnit prints "No code coverage driver
	# available" on every run and teaches everyone to ignore its warnings.
	run vendor/bin/phpunit --configuration="$config" --no-coverage
}

cmd_integration() {
	_require_test_layer || return 0
	local config
	if ! config="$(_find_file .config/phpunit.integration.xml.dist .config/phpunit.integration.xml phpunit.integration.xml.dist)"; then
		if _find_file .config/phpunit.xml.dist .config/phpunit.xml phpunit.xml.dist phpunit.xml >/dev/null; then
			_missing_suite_note "integration" "unit"
			return 0
		fi
		fail "no PHPUnit suite wired for ${PROJECT_SLUG}.
  Neither an integration config nor a unit one exists. An integration suite
  needs its own PHPUnit config plus the WordPress test library; see
  .config/phpunit.integration.xml.dist after a \`harness sync\`."
	fi
	_require_binary phpunit phpunit/phpunit

	local env_file=".config/wp-tests.env"
	if [[ ! -f "$PROJECT_ROOT/$env_file" ]]; then
		fail "no WordPress test stack configured for ${PROJECT_SLUG}.
  Run this once:
      bin/harness setup"
	fi

	step "Integration tests, real WordPress (${config})"

	# The env file holds paths *relative to the project*, because the absolute
	# path differs between the host and the container. It is sourced inside the
	# backend and absolutised there, so one file is valid in both.
	#
	# The previous LocalWP-only path sourced the file on the host and then ran
	# PHPUnit with container paths that pointed at the host's home directory.
	#
	# `WP_MULTISITE` is forwarded explicitly: ddev exec does not carry arbitrary
	# host variables into the container, so `WP_MULTISITE=1 bin/harness
	# integration` would otherwise quietly run the single-site suite and report
	# the twelve multisite tests as skipped.
	local forward=""
	if [[ -n "${WP_MULTISITE:-}" ]]; then
		forward="export WP_MULTISITE=${WP_MULTISITE@Q};"
		info "multisite mode: WP_MULTISITE=${WP_MULTISITE}"
	fi

	# Extra arguments are forwarded, so `bin/harness integration --filter X`
	# works. `workflow.md` documented exactly that through local-wp-cli.sh, and
	# a runner that cannot narrow a suite makes "run this one file" impossible.
	local extra=""
	if [[ $# -gt 0 ]]; then
		extra="$(printf '%q ' "$@")"
	fi

	run_sh "set -a; . ./${env_file}; set +a; \
		export WP_TESTS_DIR=\"\$PWD/\$WP_TESTS_DIR\" \
		       WP_CORE_DIR=\"\$PWD/\$WP_CORE_DIR\" \
		       TMPDIR=\"\$PWD/\$TMPDIR\"; \
		${forward} \
		mkdir -p \"\$WP_TESTS_DIR\" \"\$WP_CORE_DIR\" \"\$TMPDIR\"; \
		exec vendor/bin/phpunit --configuration=${config@Q} --no-coverage ${extra}"
}

# The development toolchain every project's gates need.
#
# Declared here rather than left to each project because the gates belong to the
# harness, not to the project. `lint:wpcs` cannot run without WPCS, `test`
# without PHPUnit, `mutation` without Infection — and discovering that from
# "vendor/bin/phpcs is missing", then running `composer require` by hand, is the
# copy-paste this exists to remove. It was done by hand once, for the stage 4
# pilot, and that was one theme too many.
#
# Versions track the reference plugin and are deliberately conservative: PHPUnit
# stays on 9.6 because PHP 8.1 is still in the matrix, and PHPUnit 11 would drop
# that leg.
HARNESS_DEV_REQUIREMENTS=(
	"squizlabs/php_codesniffer:^3.11"
	"wp-coding-standards/wpcs:^3.1"
	"phpstan/phpstan:^2.1"
	"szepeviktor/phpstan-wordpress:^2.0"
	"phpstan/phpstan-strict-rules:^2.0"
	"phpstan/phpstan-deprecation-rules:^2.0"
	"phpcompatibility/phpcompatibility-wp:^2.1"
	"sirbrillig/phpcs-variable-analysis:^2.11"
	"dealerdirect/phpcodesniffer-composer-installer:^1.0"
	"phpunit/phpunit:^9.6"
	"yoast/phpunit-polyfills:^2.0"
	"infection/infection:^0.35"
)

# Tools D8 replaces, and why each one is a warning rather than a removal.
HARNESS_BESPOKE_TOOLS=(
	"friendsofphp/php-cs-fixer"
)

# The npm half of the same contract. `name:range`, and the range is enforced.
#
# Presence is not enough, and this is not hypothetical: holdmywp-theme already
# had `archiver: ^8.0.0` from the bespoke toolchain it was migrating off, and
# `npm install` only ever checked that the package was there. The hand-written
# packager this harness used then called the archiver v7 API and died on
# `archiver is not a function`, because v8 exports named classes and no longer
# exports the callable. The packager is gone — packaging is `wp dist-archive`
# now — and the version contract stays, because the same trap is available to
# every dependency the build actually uses.
#
# The build belongs to `@wordpress/scripts` on both sides of the fleet, and the
# plugins already prove the shape: `wp-scripts build assets/src/index.js
# --output-path=assets/build` keeps the `assets/` layout rather than adopting
# the tool's own `src/` to `build/` convention, so the PHP that enqueues the
# assets keeps pointing where it always did.
HARNESS_NPM_REQUIREMENTS=(
	"@wordpress/scripts:*"
)

# Composer plugins this fleet answers for, rather than leaving to a prompt.
#
# Composer refuses to finish an install while a package's plugin is undecided,
# and the failure lands *after* the lock file is written — so it reads as a
# broken dependency rather than as a missing answer. Verified on
# holdmywp-theme, where the install stopped on `infection/extension-installer`
# with a lock file already on disk.
#
# `dealerdirect` is true because WPCS registers its `WordPress` standard with
# PHP_CodeSniffer through it, and without it `phpcs -i` never lists WordPress.
# `infection/extension-installer` is false: it auto-discovers Infection
# extensions, this fleet uses none, and running install-time code for a
# capability nothing here needs is a poor trade.
HARNESS_ALLOW_PLUGINS=(
	"dealerdirect/phpcodesniffer-composer-installer:true"
	"infection/extension-installer:false"
)

_ensure_dev_toolchain() {
	local composer_json="$PROJECT_ROOT/composer.json"
	if [[ ! -f "$composer_json" ]]; then
		warn "no composer.json — every gate that needs Composer will fail here."
		return 0
	fi

	local entry plugin answer
	for entry in "${HARNESS_ALLOW_PLUGINS[@]}"; do
		plugin="${entry%%:*}"
		answer="${entry##*:}"
		grep -q "\"$plugin\"" "$composer_json" && continue
		step "Answering for the Composer plugin ${plugin}"
		run composer config --no-plugins "allow-plugins.${plugin}" "$answer"
	done

	local missing=() entry name
	for entry in "${HARNESS_DEV_REQUIREMENTS[@]}"; do		name="${entry%%:*}"
		grep -q "\"$name\"" "$composer_json" || missing+=("$entry")
	done

	if [[ ${#missing[@]} -gt 0 ]]; then
		step "Adding the development toolchain (${#missing[@]} package(s))"
		printf '  %s\n' "${missing[@]}"
		# `-W` is not optional here. A partial update refuses to move a
		# transitive dependency the lock file has already pinned, and the
		# failure reads as a conflict between the two tools when it is only a
		# conflict with the lock: php-cs-fixer accepts sebastian/diff ^4 through
		# ^6, but the lock holds 6.0.2 and PHPUnit 9.6 needs ^4.0.6. Verified on
		# holdmywp-theme, where the plain form failed and this one succeeded.
		run composer require --dev --no-interaction --with-all-dependencies "${missing[@]}"
	fi

	# Declared is not installed, and the difference is invisible from
	# composer.json. A `composer require` that fails *after* writing the lock —
	# which the blocked-plugin check above does — leaves the manifest listing
	# packages the vendor tree does not have. The next run then finds nothing
	# missing, installs nothing, and the setup dies further down on
	# "vendor/bin/phpunit is missing", which points at the wrong thing entirely.
	# Verified on holdmywp-theme.
	local binary
	for binary in phpcs phpunit phpstan; do
		[[ -x "$PROJECT_ROOT/vendor/bin/$binary" ]] && continue
		step "Installing the locked dependencies (vendor/bin/$binary is absent)"
		run composer install --no-interaction
		break
	done

	# Reported, not removed. D8 drops the bespoke formatter, but the project's
	# own `lint:php` script calls it — removing the package without removing the
	# script leaves a broken script behind, which is a worse state than the one
	# being fixed. The two go together, deliberately.
	local tool
	for tool in "${HARNESS_BESPOKE_TOOLS[@]}"; do
		grep -q "\"$tool\"" "$composer_json" || continue
		warn "${tool} is still required, and D8 replaces it with WPCS."
		warn "  The two disagree — it enforces PSR-12, WPCS enforces tabs and"
		warn "  'foo( \$x )' — so each rewrites the other's output. Remove the package"
		warn "  and the scripts that call it, together:"
		warn "    bin/harness composer remove --dev ${tool}"
	done

	_ensure_npm_toolchain
}

# The npm half, checked the same way and for the same reason.
#
# `node_modules` existing is not the same as the toolchain being installed: a
# project that ran `npm install` before the requirement was declared has a full
# tree and no `@wordpress/scripts`, and `bin/harness build` then fails on
# `wp-scripts: not found` rather than on anything to do with the build.
#
# The installed major is checked, not just the entry's presence. A project that
# already pinned a package from its bespoke toolchain keeps that pin, and `npm
# install --save-dev <name>` leaves it alone — which is how holdmywp-theme
# kept `archiver ^8` and failed on `archiver is not a function`.
_ensure_npm_toolchain() {
	local manifest="$PROJECT_ROOT/package.json"
	if [[ ! -f "$manifest" ]]; then
		return 0
	fi

	local missing=() entry package range wanted installed
	for entry in "${HARNESS_NPM_REQUIREMENTS[@]}"; do
		package="${entry%%:*}"
		range="${entry##*:}"

		if ! grep -q "\"$package\"" "$manifest"; then
			missing+=("${package}@${range}")
			continue
		fi
		# `*` means any version will do. Otherwise the major has to match: it is
		# coarse on purpose, because a major bump is where an API moves, and
		# comparing ranges in bash would cost more than it is worth here.
		if [[ "$range" == "*" ]]; then
			continue
		fi
		wanted="$(printf '%s' "$range" | tr -dc '0-9' | head -c 1)"
		installed="$(
			sed -n 's/.*"version": *"\([0-9][0-9]*\)\..*/\1/p' \
				"$PROJECT_ROOT/node_modules/${package}/package.json" 2>/dev/null | head -1
		)"
		if [[ -n "$installed" && -n "$wanted" && "$installed" != "$wanted" ]]; then
			warn "${package} ${installed}.x is installed, and this project's tooling"
			warn "  needs ${range}. Pinning it."
			missing+=("${package}@${range}")
		fi
	done
	if [[ ${#missing[@]} -eq 0 ]]; then
		return 0
	fi

	step "Adding the npm toolchain (${#missing[@]} package(s))"
	printf '  %s\n' "${missing[@]}"
	run npm install --save-dev "${missing[@]}"
}

# Installs WordPress core and the test library, and creates the test database.
#
# Split out of cmd_setup so it can be skipped: it is the step that needs a
# suite to exist, and the step whose installer is a per-project file.
_setup_wp_test_stack() {
	step "WordPress integration test stack"
	require_tool wp
	_require_binary phpunit phpunit/phpunit

	local env_file=".config/wp-tests.env"
	local force="${1:-}"

	if [[ ! -f "$PROJECT_ROOT/$env_file" || "$force" == "--force" ]]; then
		local db_name db_user db_pass db_host
		db_name="$(run_sh 'wp config get DB_NAME' 2>/dev/null | tr -d '[:space:]')"
		db_user="$(run_sh 'wp config get DB_USER' 2>/dev/null | tr -d '[:space:]')"
		db_pass="$(run_sh 'wp config get DB_PASSWORD' 2>/dev/null | tr -d '[:space:]')"
		db_host="$(run_sh 'wp config get DB_HOST' 2>/dev/null | tr -d '[:space:]')"

		if [[ -z "$db_name" || -z "$db_user" ]]; then
			fail "could not read the database credentials from ${PROJECT_SLUG}.
  \`wp config get\` returned nothing for DB_NAME/DB_USER. Check that the site
  is reachable from the '$BACKEND' backend."
		fi
		db_host="${db_host:-localhost}"
		info "site database: ${db_name} on ${db_host}, as ${db_user}"
		# The site's own user has rights on the site's database, not on the
		# MySQL server, so it can neither create the test database nor use it
		# afterwards. Verified on DDEV: `mariadb --user=db` fails to CREATE
		# DATABASE with "Access denied for user 'db'@'%' to database 'db_test'".
		#
		# Every local WordPress stack this fleet runs on exposes a root
		# superuser, and `.config/wp-tests-env.example` documented `root`/`root`
		# before this file existed. It is probed, not assumed.
		local admin_user admin_pass
		if ! _admin_db_credentials "$db_host" "$db_pass"; then
			fail "no database user in the '$BACKEND' backend can create a database.
  Tried root/root, root/<site password>, and ${db_user}/<site password>.
  The WordPress test suite needs a fresh database to install into."
		fi
		admin_user="$_DB_ADMIN_USER"
		admin_pass="$_DB_ADMIN_PASS"
		[[ "$admin_user" == "$db_user" ]] || info "using ${admin_user} for the test database"

		_local_write_env "$env_file" "${db_name}_test" "$admin_user" "$admin_pass" "$db_host"
		info "wrote ${env_file}"
	else
		info "keeping existing ${env_file} (pass --force to regenerate)"
	fi

	# The database is created here rather than by the installer, which asks
	# before touching one that already exists. It is one per site and every
	# project in that site shares it, so "already exists" is the normal case and
	# the question is always the same. `IF NOT EXISTS` makes this idempotent.
	run_sh "set -a; . ./${env_file}; set +a; \
		client=\"\$(command -v mariadb 2>/dev/null || command -v mysql 2>/dev/null)\"; \
		\$client --user=\"\$WP_TEST_DB_USER\" --password=\"\$WP_TEST_DB_PASSWORD\" \
			--host=\"\$WP_TEST_DB_HOST\" --protocol=tcp \
			--execute=\"CREATE DATABASE IF NOT EXISTS \\\`\$WP_TEST_DB_NAME\\\`;\" >/dev/null"

	# `install-wp-tests.sh` downloads WordPress core and the test library, and
	# creates the test database. Both land under .cache/, which is gitignored
	# and inside the project, so the container can see them as well as the host.
	run_sh "set -a; . ./${env_file}; set +a; \
		export WP_TESTS_DIR=\"\$PWD/\$WP_TESTS_DIR\" \
		       WP_CORE_DIR=\"\$PWD/\$WP_CORE_DIR\" \
		       TMPDIR=\"\$PWD/\$TMPDIR\"; \
		mkdir -p \"\$WP_TESTS_DIR\" \"\$WP_CORE_DIR\" \"\$TMPDIR\"; \
		if [ -f \"\$WP_TESTS_DIR/includes/functions.php\" ] \
			&& [ -f \"\$WP_CORE_DIR/wp-settings.php\" ] \
			&& [ -f \"\$WP_TESTS_DIR/wp-tests-config.php\" ]; then \
			echo 'WordPress test library already installed.'; \
		else \
			echo 'Installing WordPress core and the test library (one-time, may take a minute)...'; \
			bash bin/install-wp-tests.sh \"\$WP_TEST_DB_NAME\" \"\$WP_TEST_DB_USER\" \"\$WP_TEST_DB_PASSWORD\" \"\$WP_TEST_DB_HOST\" latest true; \
		fi"

	# `true` as the sixth argument is `SKIP_DB_CREATE`, and it is not an
	# optimisation. Without it the installer finds the test database already
	# present — it is one per site, and every project in that site shares it —
	# and stops to ask `Are you sure you want to proceed? [y/N]`. A setup with
	# no terminal answers that with EOF, which reads as "no", and the run ends
	# in an exit status with nothing to explain it. The database is created
	# above instead, where the credentials are already known.

	# All three files, not just the library. `install-wp-tests.sh` leaves
	# `wp-tests-config.php` alone when it already exists, so a first run with the
	# wrong credentials leaves a config that silently points at a database the
	# user cannot open. Checking only for the library reported success.
	if ! run_sh "set -a; . ./${env_file}; set +a; \
		test -f \"\$PWD/\$WP_TESTS_DIR/includes/functions.php\" \
		&& test -f \"\$PWD/\$WP_CORE_DIR/wp-settings.php\" \
		&& test -f \"\$PWD/\$WP_TESTS_DIR/wp-tests-config.php\""; then
		fail "the WordPress test stack is incomplete after setup.
  Look above for the first error the installer reported."
	fi

	# A theme has to be reachable from the test core's `wp-content/themes`.
	#
	# A plugin's suite requires its main file on `muplugins_loaded` and needs
	# nothing from wp-content. A theme has to be switched to, and
	# `switch_theme()` only finds themes in the installed tree — which is a
	# freshly downloaded core with the default themes and nothing else.
	#
	# Symlinked rather than copied, so the tests run the working tree and no
	# rebuild sits between a change and its result. A child theme needs its
	# parent there too, and `Template:` in `style.css` is what names it. Both
	# are needed before a theme's first test can run, and neither is a line the
	# installer script could have covered: it does not know what a theme is.
	if [[ "$PROJECT_KIND" == "theme" ]]; then
		local project_dir parent
		project_dir="$(basename "$PROJECT_ROOT")"
		parent="$(sed -n 's/^[[:space:]]*Template:[[:space:]]*//p' "$PROJECT_ROOT/style.css" 2>/dev/null | head -1 | tr -d '\r' | tr -d '[:space:]')"

		run_sh "set -a; . ./${env_file}; set +a; \
			themes=\"\$PWD/\$WP_CORE_DIR/wp-content/themes\"; \
			mkdir -p \"\$themes\"; \
			ln -sfn \"\$PWD\" \"\$themes/${project_dir}\"; \
			if [ -n '${parent}' ]; then \
				ln -sfn \"\$PWD/../../themes/${parent}\" \"\$themes/${parent}\"; \
			fi"

		if [[ -n "$parent" ]]; then
			info "test core: ${project_dir} linked, and its parent ${parent} with it"
		else
			info "test core: ${project_dir} linked"
		fi
	fi

}

# Point git at `.githooks/`.
#
# The three hooks are shipped, staged and reviewed, and until this existed none
# of them ran. `core.hooksPath` is per-clone configuration: it lives in
# `.git/config`, which is not committed and not cloned, so a project could carry
# a pre-commit hook for its whole life and never execute it once. Two projects
# had it set by hand and five did not, which is exactly the failure mode -- it
# looks wired, and the only way to tell was to commit and watch nothing happen.
#
# `setup` is where it belongs rather than `sync`: it is a per-clone action, and
# `sync` is run by the generator against projects that may not be the ones
# working in them. It is idempotent, and `doctor` reports the state.
_wire_git_hooks() {
	[[ -d "$PROJECT_ROOT/.githooks" ]] || return 0
	[[ -d "$PROJECT_ROOT/.git" ]] || return 0

	local current
	current="$(cd "$PROJECT_ROOT" && git config --local --get core.hooksPath 2>/dev/null || true)"
	if [[ "$current" == ".githooks" ]]; then
		return 0
	fi

	# `--local` writes to this clone only. A global hooks path would apply the
	# fleet's gates to every repository on the machine.
	(cd "$PROJECT_ROOT" && git config --local core.hooksPath .githooks)
	info "git hooks wired: core.hooksPath = .githooks"
}

cmd_setup() {
	step "Development environment (${PROJECT_SLUG})"

	_wire_git_hooks

	[[ -d "$PROJECT_ROOT/vendor" ]] || { step "Composer dependencies"; run composer install; }
	[[ -d "$PROJECT_ROOT/node_modules" ]] || { step "npm dependencies"; run npm install; }

	# Before the test stack, not after: that step requires PHPUnit and fails
	# outright without it, which is how the pilot theme's first WPCS run ended
	# in "vendor/bin/phpcs is missing" instead of in a lint report.
	_ensure_dev_toolchain

	# Only when the project carries a test layer and has an integration suite
	# to run. A theme carries no test layer at all (ADR 0009), and `_require_
	# test_layer` is the one place that says so; a plugin whose tests are all
	# unit tests has no integration suite, and the installer is a file a plugin
	# that never declared one does not need.
	#
	# Building a stack a project has nothing to point at it costs a WordPress
	# download and then fails on `bash: bin/install-wp-tests.sh: No such file or
	# directory`, which reads as a broken setup rather than an absent suite.
	# Verified on holdmywp-theme.
	if _require_test_layer; then
		if [[ -n "$(_config_with_tests .config/phpunit.integration.xml.dist .config/phpunit.integration.xml || true)" ]]; then
			_setup_wp_test_stack "${1:-}"
		else
			step "WordPress integration test stack"
			info "no integration suite declared — nothing to point at a test database"
			info "add tests/Integration and .config/phpunit.integration.xml.dist to enable it"
		fi
	fi

	step "Ready"
	info "bin/harness lint          WPCS + PHPStan"
	info "bin/harness build         the front-end bundle"
	info "bin/harness verify        the pre-push gate"
}

# Sets _DB_ADMIN_USER / _DB_ADMIN_PASS to a pair that can create a database.
_admin_db_credentials() {
	local host="$1" site_pass="$2"
	local client
	client="$(run_sh 'command -v mariadb 2>/dev/null || command -v mysql 2>/dev/null' | tr -d '[:space:]')"
	if [[ -z "$client" ]]; then
		fail "no MySQL client in the '$BACKEND' backend"
	fi

	local attempt user pass protocol
	# `--protocol=tcp` first: DDEV's database service is reached over the
	# network. A socket-based host (LocalWP's `localhost`) only answers the
	# second pass, which is why the protocol is not hardcoded.
	for protocol in "--protocol=tcp" ""; do
		for attempt in "root:root" "root:${site_pass}" "root:"; do
			user="${attempt%%:*}"
			pass="${attempt#*:}"
			if run_sh "${client} --user=${user@Q} --password=${pass@Q} --host=${host@Q} ${protocol} --execute='SELECT 1' >/dev/null 2>&1"; then
				_DB_ADMIN_USER="$user"
				_DB_ADMIN_PASS="$pass"
				return 0
			fi
		done
	done
	return 1
}

# Paths are relative on purpose: the same file then works on the host and in the
# container, where $HOME and the absolute prefix differ. `cmd_setup` and
# `cmd_integration` absolutise them against $PWD at run time.
_local_write_env() {
	local env_file="$1" db_name="$2" db_user="$3" db_pass="$4" db_host="$5"
	local target="$PROJECT_ROOT/$env_file"
	mkdir -p "$PROJECT_ROOT/.config" "$PROJECT_ROOT/.cache/wp-tests/tmp"

	# The site's own URL, asked of WordPress rather than assumed.
	#
	# `wp option get siteurl` answers on every backend this fleet runs on, so it
	# works on DDEV, on LocalWP and on the host without a branch. It is what the
	# end-to-end browser needs: the E2E config used to hardcode a hostname, and
	# the one it hardcoded belonged to a different site.
	local site_url
	site_url="$(run_sh 'wp option get siteurl' 2>/dev/null | tr -d '[:space:]' || true)"

	# A dedicated administrator for the browser, never the owner's account.
	#
	# The password is generated once and kept in this file, which is gitignored
	# and machine-specific -- the same place the test database credentials live.
	# It is deliberately NOT read back from WordPress: `wp user get` exposes a
	# hash, not a password, and `--field=user_pass` is not a field that exists.
	# Reading it is how this file stopped being written at all -- the assignment
	# failed, `set -e` ended the script, and `setup --force` reported nothing.
	local e2e_user="harness-e2e" e2e_pass
	e2e_pass="$(sed -n 's/^WP_PASSWORD=//p' "$target" 2>/dev/null | head -1 | tr -d '"'"'"'[:space:]' || true)"
	if [[ -z "$e2e_pass" ]]; then
		e2e_pass="$(run_sh 'head -c 24 /dev/urandom | base64 | tr -d "/+="' 2>/dev/null | tr -d '[:space:]' || true)"
	fi
	[[ -n "$e2e_pass" ]] || e2e_pass="harness-e2e-local"

	{
		printf '# Generated by `bin/harness setup` on %s.\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
		printf '# Machine-specific and gitignored. Regenerate with: bin/harness setup --force\n'
		printf '#\n'
		printf '# Paths are relative to the project root so this file is valid on the\n'
		printf '# host and inside the container alike.\n\n'
		printf 'WP_TESTS_DIR=".cache/wp-tests/wordpress-tests-lib"\n'
		printf 'WP_CORE_DIR=".cache/wp-tests/wordpress"\n'
		printf 'TMPDIR=".cache/wp-tests/tmp"\n'
		printf 'WP_TEST_DB_NAME=%s\n' "$(printf '%q' "$db_name")"
		printf 'WP_TEST_DB_USER=%s\n' "$(printf '%q' "$db_user")"
		printf 'WP_TEST_DB_PASSWORD=%s\n' "$(printf '%q' "$db_pass")"
		printf 'WP_TEST_DB_HOST=%s\n' "$(printf '%q' "$db_host")"
		printf '\n# End-to-end browser. WP_BASE_URL is the site as WordPress sees itself.\n'
		printf 'WP_BASE_URL=%s\n' "$(printf '%q' "${site_url:-https://localhost}")"
		printf 'WP_USERNAME=%s\n' "$(printf '%q' "$e2e_user")"
		printf 'WP_PASSWORD=%s\n' "$(printf '%q' "${e2e_pass:-}")"
		printf 'export WP_TESTS_DIR WP_CORE_DIR TMPDIR WP_TEST_DB_NAME WP_TEST_DB_USER WP_TEST_DB_PASSWORD WP_TEST_DB_HOST WP_BASE_URL WP_USERNAME WP_PASSWORD\n'
	} > "$target"
}

# The administrator the browser logs in as, created on demand.
#
# E2E needs credentials and there are none to read: WordPress stores a password
# hash, so an existing account cannot be used without the owner typing one in --
# and asking for that is a setup step that gets skipped once and then fails as a
# login timeout. So the harness owns a test account instead, with a password it
# generates, and refreshes it when it is missing.
#
# It is deliberately not the owner's account: E2E navigates the admin and can
# leave state behind, and that should not happen as the person who owns the
# site.
HARNESS_E2E_USER="harness-e2e"

_ensure_e2e_user() {
	require_tool wp
	local password="${1:-}"
	[[ -n "$password" ]] || password="harness-e2e-local"

	if run_sh "wp user get ${HARNESS_E2E_USER} --field=ID" >/dev/null 2>&1; then
		# The account exists. Re-set its password from the file: that file is
		# the record, and the two drifting apart is a login timeout with no clue
		# in it.
		if run wp user update "$HARNESS_E2E_USER" --user_pass="$password" >/dev/null; then
			info "E2E administrator '${HARNESS_E2E_USER}' password refreshed"
		else
			warn "could not refresh the password for '${HARNESS_E2E_USER}'"
		fi
		return 0
	fi

	# No `--skip-email`: WP-CLI has no such flag, and passing one made the whole
	# command fail with "unknown --skip-email parameter". The failure was
	# swallowed by the caller's `|| warn`, and this function reported success
	# anyway. Playwright's only complaint was "Not logged in", three steps away
	# from the cause. WP-CLI sends no mail unless `--send-email` is passed, so
	# there is nothing to suppress.
	if run wp user create "$HARNESS_E2E_USER" "${HARNESS_E2E_USER}@localhost.test" \
		--role=administrator \
		--user_pass="$password" >/dev/null; then
		info "created the E2E administrator '${HARNESS_E2E_USER}'"
		return 0
	fi

	warn "could not create the E2E administrator '${HARNESS_E2E_USER}'"
	return 1
}

cmd_e2e() {
	_require_test_layer || return 0
	step "End-to-end (Playwright)"
	_require_frontend || return 0

	local config_rel="tests/e2e/playwright.config.js"
	local config="$PROJECT_ROOT/$config_rel"
	if [[ ! -f "$config" ]]; then
		info "${PROJECT_SLUG} has no E2E suite; tests/e2e/playwright.config.js does not exist."
		return 0
	fi

	# The suite needs a site to drive and an account to drive it with. Both come
	# from the generated env when it exists, so a project that has never run
	# `setup` gets told that rather than a browser timeout.
	local base_url="" username="" password=""
	if [[ -f "$PROJECT_ROOT/.config/wp-tests.env" ]]; then
		base_url="$(sed -n 's/^WP_BASE_URL=//p' "$PROJECT_ROOT/.config/wp-tests.env" | head -1 | tr -d '"'"'"'[:space:]' || true)"
		username="$(sed -n 's/^WP_USERNAME=//p' "$PROJECT_ROOT/.config/wp-tests.env" | head -1 | tr -d '"'"'"'[:space:]' || true)"
		password="$(sed -n 's/^WP_PASSWORD=//p' "$PROJECT_ROOT/.config/wp-tests.env" | head -1 | tr -d '"'"'"'[:space:]' || true)"
	fi
	if [[ -z "$base_url" || -z "$password" ]]; then
		info "no E2E credentials yet — run: bin/harness setup"
		base_url="$(run_sh 'wp option get siteurl' 2>/dev/null | tr -d '[:space:]' || true)"
		username="${username:-$HARNESS_E2E_USER}"
	fi
	[[ -n "$base_url" ]] || fail "could not resolve the site URL for the browser."

	# Keep the account and the file in agreement. `|| true` because a site whose
	# admin cannot create users should still get Playwright's own error, which
	# names the login that failed.
	_ensure_e2e_user "$password" || warn "could not provision the E2E user"

	# Where the session is written, and where failure artefacts land. Both live
	# under `.cache/`, which is gitignored and already excluded from the
	# distributable -- a storage state is a live admin session and must not be
	# committed.
	#
	# Relative paths, like the `--config` above and for the same reason: the
	# command runs with the project as its working directory in every backend,
	# and a host-absolute path is not a path inside the container. Playwright
	# resolved `/home/…/tests/e2e/playwright.config.js` from the container's
	# filesystem root and reported "does not exist".
	local state=".cache/e2e/storage-state.json" artifacts=".cache/e2e/artifacts"
	mkdir -p "$PROJECT_ROOT/.cache/e2e"

	info "site ${base_url}, user ${username}"
	run_sh "WP_BASE_URL=${base_url@Q} WP_USERNAME=${username@Q} WP_PASSWORD=${password@Q} \
		STORAGE_STATE_PATH=${state} \
		WP_ARTIFACTS_PATH=${artifacts} \
		npx playwright test --config ${config_rel@Q} ${*:-}"
}

# Xdebug is off by default on this machine, on purpose. `ddev xdebug status`
# used to report "enabled" while config.yaml said otherwise, and a permanent
# step debugger costs every PHP call in the project, not just the instrumented
# ones — plus a "could not connect to debugging client" line on every command.
# Coverage is therefore requested per invocation.
#
# PCOV is preferred when it is loaded: it is roughly ten times faster than
# Xdebug and has no debugger side effects.
#
# `COVERAGE_FLAGS` is passed with `-d` to the php that is launched directly.
# `-d` reaches that process and nothing else, which is not enough: PHPUnit runs
# a test marked `@runInSeparateProcess` in a fresh `php`, so a project with
# isolated tests had no driver in the children and the coverage run died with
# "No code coverage driver available". `COVERAGE_EXPORT` is a shell prefix that
# names the same driver in an `.ini` on PHP's scan path and exports
# `PHP_INI_SCAN_DIR`, which every child inherits. A project that needs it:
# updatronix-pro, eight test classes isolated.
COVERAGE_FLAGS=()
COVERAGE_EXPORT=""
COVERAGE_INI_REL=".cache/coverage-ini"

# Probed by output, not by exit status. `ddev exec` prints a loud
# "Failed to execute command" line to stderr whenever the wrapped command exits
# non-zero, so a `grep -q` that legitimately finds nothing looked like a
# failure on every coverage and mutation run.
_php_has_module() {
	local module="$1"
	local found
	found="$(run_sh "php -m 2>/dev/null | grep -ix ${module@Q} || true" | tr -d '[:space:]')"
	[[ -n "$found" ]]
}

# The directory PHP scans for extra `.ini` files, so the appended one does not
# displace the extensions already loaded from there.
_php_scan_dir() {
	local dir
	dir="$(run_sh "php --ini 2>/dev/null | sed -n 's/^Scan for additional .ini files in: //p'" 2>/dev/null | tr -d '\r\n')"
	printf '%s' "${dir:-/etc/php/8.4/cli/conf.d}"
}

# Writes the scan-path ini and sets `COVERAGE_EXPORT`. `extra` is the
# `zend_extension=` line, present only when the driver is not loaded already --
# naming a loaded extension again is an error, not a no-op.
_coverage_ini() {
	local extra="$1"
	local dir="$PROJECT_ROOT/$COVERAGE_INI_REL"
	mkdir -p "$dir"
	{
		[[ -n "$extra" ]] && printf '%s\n' "$extra"
		printf 'xdebug.mode=coverage\n'
		# opcache JIT cannot coexist with an extension overriding
		# zend_execute_ex; without this every run prints a warning.
		printf 'opcache.jit=disable\n'
	} >"$dir/driver.ini"
	COVERAGE_EXPORT="export PHP_INI_SCAN_DIR=$(_php_scan_dir):$PROJECT_CONTAINER_DIR/$COVERAGE_INI_REL;"
}

_coverage_driver() {
	if _php_has_module pcov; then
		COVERAGE_FLAGS=(-d pcov.enabled=1)
		info "coverage driver: pcov"
		return 0
	fi

	if _php_has_module xdebug; then
		_coverage_ini ""
		info "coverage driver: xdebug, already loaded"
		return 0
	fi

	# `ddev xdebug off` does not set mode=off: it stops loading the extension
	# altogether, so `-d xdebug.mode=coverage` alone has nothing to configure.
	# The shared object is still on disk, so loading it for a single invocation
	# works — verified: extension_loaded(xdebug) goes false -> true and
	# xdebug_get_code_coverage() becomes available. No image rebuild, no
	# permanently loaded debugger, and coverage only where it was asked for.
	if run_sh 'php -d zend_extension=xdebug.so -m 2>/dev/null | grep -qix xdebug || true' >/dev/null 2>&1; then
		_coverage_ini "zend_extension=xdebug.so"
		info "coverage driver: xdebug, loaded for this invocation only"
		return 0
	fi

	fail "no coverage driver available in the '$BACKEND' backend.
  Neither pcov nor xdebug is loaded, and xdebug.so could not be loaded on demand.
  Install one in .ddev/web-build/Dockerfile, or run: ddev xdebug on"
}

cmd_coverage() {
	_require_test_layer || return 0
	local suite="unit"
	if [[ "${1:-}" == "--suite" ]]; then
		suite="${2:-unit}"
		shift 2 || true
	fi

	local config
	case "$suite" in
	unit)
		config="$(_require_config 'PHPUnit' .config/phpunit.xml.dist .config/phpunit.xml phpunit.xml.dist phpunit.xml)"
		;;
	integration)
		config="$(_require_config 'PHPUnit integration' .config/phpunit.integration.xml.dist .config/phpunit.integration.xml)"
		;;
	*)
		fail "unknown coverage suite: ${suite} (expected unit or integration)"
		;;
	esac

	step "Coverage — ${suite} (${config})"
	_coverage_driver

	if [[ "$suite" == "integration" ]]; then
		# The integration suite needs the WordPress test stack, exactly as
		# `bin/harness integration` does. The coverage flags have to reach the
		# child through the shell, hence one string rather than an argv.
		[[ -f "$PROJECT_ROOT/.config/wp-tests.env" ]] ||
			fail "no WordPress test stack configured. Run this once: bin/harness setup"
		run_sh "set -a; . ./.config/wp-tests.env; set +a; \
			export WP_TESTS_DIR=\"\$PWD/\$WP_TESTS_DIR\" \
			       WP_CORE_DIR=\"\$PWD/\$WP_CORE_DIR\" \
			       TMPDIR=\"\$PWD/\$TMPDIR\"; \
			mkdir -p \"\$WP_TESTS_DIR\" \"\$WP_CORE_DIR\"; \
			${COVERAGE_EXPORT} exec php ${COVERAGE_FLAGS[*]} vendor/bin/phpunit \
				--configuration=${config@Q} --coverage-text"
		return 0
	fi

	run_sh "${COVERAGE_EXPORT} exec php ${COVERAGE_FLAGS[*]} vendor/bin/phpunit \
		--configuration=${config@Q} --coverage-text"
}

cmd_mutation() {
	_require_test_layer || return 0
	step "Mutation testing on the diff (anti-tautology)"

	local config=""
	local candidate
	for candidate in infection.json5 infection.json infection.json5.dist infection.json.dist; do
		if [[ -f "$PROJECT_ROOT/$candidate" ]]; then
			config="$candidate"
			break
		fi
	done
	if [[ -z "$config" ]]; then
		fail "no infection config. The harness owns this file: run \`harness sync\`
  from the generator repository.
  See DESIGN.md section 5."
	fi

	if [[ ! -x "$PROJECT_ROOT/vendor/bin/infection" ]]; then
		fail "infection is not installed. Add it once:
  bin/harness composer require --dev infection/infection"
	fi

	_coverage_driver

	local base="${HARNESS_MUTATION_BASE:-origin/HEAD}"
	if ! run_sh "git rev-parse --verify --quiet ${base@Q} >/dev/null"; then
		warn "git ref '${base}' does not resolve here — falling back to HEAD"
		base="HEAD"
	fi

	local threads
	threads="$(run_sh 'nproc' 2>/dev/null | tr -d '[:space:]')"
	threads="${threads:-4}"

	# The WordPress test stack, when there is one. Infection's child processes
	# inherit the environment, so it is sourced here rather than passed as PHP
	# flags. Without it the integration bootstrap dies with "WordPress test
	# library not found", which reads like a setup problem rather than a
	# missing export.
	local prefix=""
	if [[ -f "$PROJECT_ROOT/.config/wp-tests.env" ]]; then
		prefix="set -a; . ./.config/wp-tests.env; set +a; \
			export WP_TESTS_DIR=\"\$PWD/\$WP_TESTS_DIR\" \
			       WP_CORE_DIR=\"\$PWD/\$WP_CORE_DIR\" \
			       TMPDIR=\"\$PWD/\$TMPDIR\";"
	fi

	# Which suite Infection mutates against.
	#
	# Infection runs the initial tests itself, using the config it finds in
	# `phpUnit.configDir` — and that directory holds both configs, so it takes
	# whichever sorts first, whatever the project's tests actually are. For a
	# project whose tests are all integration, that is an empty unit suite and
	# Infection reports invalid coverage.
	#
	# Passing the integration config through `--test-framework-extra-args` does
	# NOT work: it lands after Infection's own `--configuration`, PHPUnit
	# honours the last one, and the report Infection is waiting for is never
	# written. Verified, twice. So the coverage is produced here instead and
	# handed over, and Infection is only ever asked to consume a report.
	local phpunit_config
	phpunit_config="$(_tests_config || true)"
	if [[ -z "$phpunit_config" ]]; then
		fail "no PHPUnit config declares a directory containing tests.
  Infection changes the code and asks the suite which mutants survived. With no
  suite to ask, every mutant survives and the report is noise."
	fi

	# Infection locates the PHPUnit config itself, by name, in
	# `phpUnit.configDir` (`.config`). It searches for `phpunit.xml`,
	# `phpunit.xml.dist` and a few other spellings -- not for
	# `phpunit.integration.xml.dist`, which is the name this fleet gives the
	# integration config. So a plugin whose only suite is the integration one
	# made Infection refuse with "Could not locate the files phpunit.xml,
	# phpunit.yml, …" before it reported anything, however much coverage the
	# runtime handed it. The config it resolved is linked under a name Infection
	# accepts, beside the original so relative `<directory>` paths keep their
	# meaning, and the link is removed however this exits.
	#
	# The path is a global, not a `local`: the trap fires on EXIT, after this
	# function's scope has gone, and a `local` there is an unbound variable
	# under `set -u` -- which is how the first version left the link behind.
	if [[ "$phpunit_config" == .config/* \
		&& ! -e "$PROJECT_ROOT/.config/phpunit.xml.dist" \
		&& ! -e "$PROJECT_ROOT/.config/phpunit.xml" ]]; then
		MUTATION_CONFIG_LINK="$PROJECT_ROOT/.config/phpunit.xml.dist"
		ln -s "$(basename "$phpunit_config")" "$MUTATION_CONFIG_LINK"
		trap 'rm -f "$MUTATION_CONFIG_LINK"' EXIT INT TERM
	fi

	# PHPUnit prints "No filter is configured, code coverage will not be
	# processed" and writes nothing when the config has no include list, so
	# Infection then reports invalid coverage rather than naming the real cause.
	if ! grep -q '<coverage' "$PROJECT_ROOT/$phpunit_config" 2>/dev/null; then
		fail "${phpunit_config} declares no <coverage> section.
  PHPUnit writes no report without one, and Infection reports that as invalid
  coverage. Add the paths the suite covers:
    <coverage><include><directory suffix=\".php\">../inc</directory></include></coverage>"
	fi

	# `.cache/` rather than `build/`: both are transient, but only `.cache/` is
	# ignored in every project — a report directory that shows up in
	# `git status` is a report directory people will try to delete.
	local coverage_dir=".cache/infection-coverage"
	run_sh "rm -rf ${coverage_dir@Q} && mkdir -p ${coverage_dir@Q}"

	step "Coverage (${phpunit_config}) — Infection will not run the tests itself"
	# Both reports land in one directory: Infection looks for `index.xml` and a
	# `junit.xml` side by side and will not look in two places.
	run_sh "${COVERAGE_EXPORT} ${prefix} exec php ${COVERAGE_FLAGS[*]} vendor/bin/phpunit \
		--configuration=${phpunit_config@Q} \
		--coverage-xml=${coverage_dir@Q} \
		--log-junit=${coverage_dir@Q}/junit.xml"

	step "Mutation testing on the diff against ${base}"
	# No `--initial-tests-php-options` here, and that is not an oversight: it
	# owns the `-d` flags for the initial run, which this invocation has just
	# done itself. Passing it alongside `--skip-initial-tests` makes Infection
	# reject the whole command with `The "-d" option does not exist`, which
	# points at the flags rather than at the two options being mutually
	# exclusive. The mutant runs need no coverage driver, so they are faster
	# without one.
	# The two floors are ratios over the *diff's* mutants, and that is the
	# decision rather than a threshold anyone derived: the margin exists so a
	# sweep — which is what a floor raise forces — can carry mutants no test
	# can kill without making the gate unsatisfiable. `CastBool` removal on a
	# `(bool)` in a condition, `(string)` on a concatenation, an integer clamp
	# standing behind another clamp. Where a survivor is classified, and why
	# this command does not print the mutator names itself, is DESIGN.md
	# section 5; the per-line classification lives in the test file that
	# covers the line, which is where the next person reads the assertion.
	if ! run_sh "${prefix} exec php vendor/bin/infection \
		--configuration=${config@Q} \
		--coverage=${coverage_dir@Q} \
		--skip-initial-tests \
		--threads=${threads} \
		--git-diff-lines \
		--git-diff-base=${base@Q} \
		--min-msi=70 \
		--min-covered-msi=80 \
		--no-progress"; then
		# Nothing to mutate is not a failure, and treating it as one made this
		# gate impossible to satisfy: zenpress, whose tests are all integration
		# and whose code is procedural, generated zero mutants and could
		# therefore never pass pre-push.
		#
		# The signal is not lost. `bin/harness counterfactual` asks the same
		# question of the lines the suite does execute, and fails when the diff
		# changes code the tests never run. This command defers to it.
		if _explain_no_mutants; then
			warn "Nothing to judge here — bin/harness counterfactual is the gate that"
			warn "can still disagree with this diff."
			return 0
		fi
		exit 1
	fi
}

# Why a run can find nothing to mutate, when that is not a test-quality problem.
#
# Infection generates mutants only for lines the coverage report marks as
# executed. A diff that touches no covered line therefore yields zero mutants,
# and Infection then fails the MSI threshold at 0% with "Improve your tests!" —
# which blames the tests for a coverage gap they cannot express.
#
# Measured on updatronix: 27 of its 33 source files sit at 0% coverage and
# produce 0 mutants between them, while the covered ones produce 820. The
# correlation is the mechanism, not a coincidence.
#
# There is a second reason, and it is structural rather than a coverage gap.
# Infection builds mutants only for **class methods**. `ReflectionVisitor`
# returns early when no class is in scope — "No need to traverse outside of
# classes" — so `IS_INSIDE_FUNCTION_KEY` is never set for a plain function and
# `ExcludeNonMutableCodeVisitor` marks everything inside it ineligible. A
# project written as global functions produces no mutants at all, whatever its
# coverage, and no amount of testing changes that.
#
# Measured on updatronix: its one covered procedural file — 57 covered lines of
# `if`, `(bool)`, `in_array( …, true )`, `preg_match` — yields 0 mutants, while
# six class files yield 820.
_explain_no_mutants() {
	local summary=".cache/infection/infection-summary.log"
	[[ -f "$PROJECT_ROOT/$summary" ]] || return 1
	grep -qE '^Total: 0$' "$PROJECT_ROOT/$summary" || return 1

	local with_class total
	with_class="$(run_sh "grep -rlE '^[[:space:]]*(final |abstract )?class ' --include='*.php' ${PROJECT_SOURCE_DIRS} 2>/dev/null | wc -l" | tr -d '[:space:]')"
	total="$(run_sh "find ${PROJECT_SOURCE_DIRS} -name '*.php' 2>/dev/null | wc -l" | tr -d '[:space:]')"

	warn "Infection found nothing to mutate, so the MSI threshold says nothing here."
	if [[ "${with_class:-1}" -eq 0 ]]; then
		warn "${PROJECT_SLUG} declares no class at all, and Infection mutates only"
		warn "class methods: a project written as global functions yields no mutants"
		warn "whatever its coverage. That is structural, not a testing gap. See"
		warn "DESIGN.md section 5 and docs/adr/0006."
	else
		warn "It mutates only lines the coverage report marks as executed, and this diff"
		warn "touched none of them — the gate cannot protect code the suite never runs."
		if [[ -n "${total:-}" && "${total:-0}" -gt 0 ]]; then
			warn "Classes appear in ${with_class} of ${total} source file(s), and Infection"
			warn "mutates class methods only, so the procedural rest is invisible to this"
			warn "gate however well it is tested. See docs/adr/0006."
		fi
	fi
	warn "See ${summary}, and ${coverage_dir} for what the suite did reach."
}

# ---------------------------------------------------------------------------
# counterfactual
# ---------------------------------------------------------------------------

# Infection builds mutants only for class methods. Its `ReflectionVisitor`
# returns early when no class is in scope — "No need to traverse outside of
# classes" — so a plain function's body is never eligible and a project written
# as global functions produces no mutants whatever its coverage. Verified in
# Infection's own source, and measured: updatronix's one covered procedural file
# yields 0 mutants while six class files yield 820.
#
# WordPress themes are procedural by convention, so converting them to satisfy
# a tool is the wrong trade. This is the same idea at a smaller scale: one
# textual substitution on a changed line, run the suite, revert. If the suite
# still passes, nothing it asserts depended on that line.
#
# It is deliberately blunt, and weaker than Infection. Infection rewrites an
# AST node and knows the mutant is semantically valid; this rewrites text and
# has to check. `php -l` runs after each substitution, and a mutation that does
# not parse is discarded rather than counted — otherwise a syntax error would
# be reported as a kill, which is the opposite of the truth.
#
# The patterns are the unambiguous ones. Bare `<` and `>` are absent on purpose:
# they also occur in `=>` and `->`, and a substitution there corrupts the file
# instead of changing its meaning.
_counterfactual_patterns() {
	cat <<'EOF'
===
!==
!==
===
&&
||
||
&&
>=
>
<=
<
true
false
false
true
(int)
(string)
(bool)
(int)
(string)
(int)
min(
max(
max(
min(
strtolower(
strtoupper(
strtoupper(
strtolower(
array_values(
array_filter(
EOF
}

# The PHPUnit config that has tests in it, for whichever command needs one.
_tests_config() {
	_config_with_tests \
		.config/phpunit.xml.dist .config/phpunit.xml \
		.config/phpunit.integration.xml.dist .config/phpunit.integration.xml \
		phpunit.xml.dist phpunit.xml
}

# The tests that cover each executed line, as `file:line<TAB>Class::method|…`.
#
# The second half of the report `_covered_lines` reads: PHPUnit writes one
# `<covered by="…"/>` per test that executed the line, inside the `<line>`
# element. A line is emitted when its element closes, because the children come
# after the `<line nr="…">` that opens it — so the state carried across the
# three cases is the line number and the tests seen since.
#
# Two things the format makes easy to get wrong, and that were: the report has a
# second `<line …>` vocabulary — `<source>`, one `<line no="…">` per token of
# the file — and those also close with `</line>`. Read without the section, and
# every token line emits the last coverage line's tests again.
#
# The names are joined with `|` and handed to PHPUnit as one `--filter`, which
# is a PCRE. Backslashes are escaped for that reason: no test class in this
# fleet is namespaced today, and the first one that is must not silently match
# nothing — a filter that selects no tests makes PHPUnit exit non-zero, which
# this command would read as a killed mutant.
_covering_tests() {
	local dir="$1" report name
	while read -r report; do
		[[ -n "$report" ]] || continue
		name="${report#"$PROJECT_ROOT/$dir"/}"
		awk -v f="${name%.xml}" '
			/<coverage>/ { inside = 1; next }
			/<\/coverage>/ { exit }
			!inside { next }
			/<line nr="/ {
				if (match($0, /nr="[0-9]+"/)) { n = substr($0, RSTART + 4, RLENGTH - 5) }
				tests = ""
				# A covered line opens a tag that does not close on this line;
				# an uncovered one closes immediately and has no children.
				open = ($0 !~ /\/>[[:space:]]*$/)
				next
			}
			/<covered by="/ {
				if (open && match($0, /by="[^"]+"/)) {
					t = substr($0, RSTART + 4, RLENGTH - 5)
					gsub(/\\/, "\\\\", t)
					tests = (tests == "" ? t : tests "|" t)
				}
				next
			}
			/<\/line>/ {
				if (open && tests != "") { print f ":" n "\t" tests }
				open = 0
				tests = ""
				next
			}
		' "$report"
	done < <(find "$PROJECT_ROOT/$dir" -name '*.xml' ! -name 'index.xml' ! -name 'junit.xml' 2>/dev/null | sort)
}

# The `file:line` pairs the coverage report says were executed.
#
# PHPUnit writes a covered line as `<line nr="19">` with a `<covered by="…"/>`
# child and an uncovered one as a self-closing `<line nr="20"/>`, so the whole
# distinction is whether the tag closes on the same line. That is enough for
# awk, and it avoids needing an XML parser in a runtime that must run with no
# dependencies.
_covered_lines() {
	local dir="$1" report name
	while read -r report; do
		[[ -n "$report" ]] || continue
		name="${report#"$PROJECT_ROOT/$dir"/}"
		awk -v f="${name%.xml}" '
			/<line nr="/ {
				if (match($0, /nr="[0-9]+"/)) { n = substr($0, RSTART + 4, RLENGTH - 5) }
				if ($0 ~ /\/>[[:space:]]*$/) { next }
				print f ":" n
			}
		' "$report"
	done < <(find "$PROJECT_ROOT/$dir" -name '*.xml' ! -name 'index.xml' ! -name 'junit.xml' 2>/dev/null | sort)
}

cmd_counterfactual() {
	# Before anything else, and before the diff is even read: a journal left by
	# a killed run means the tree is not what git thinks it is, and every check
	# below would be reading a substituted line.
	_counterfactual_recover
	_require_test_layer || return 0
	step "Counterfactual check on the diff (for code Infection cannot reach)"
	local config
	config="$(_tests_config || true)"
	if [[ -z "$config" ]]; then
		fail "no PHPUnit config declares a directory containing tests.
  A mutation only means something if a suite can disagree with it."
	fi

	# The command that runs that suite, derived from the config rather than
	# chosen again, so the coverage report and the check can never disagree
	# about which tests are being asked.
	local suite="test"
	[[ "$config" == *integration* ]] && suite="integration"

	_coverage_driver

	local base="${HARNESS_MUTATION_BASE:-origin/HEAD}"
	if ! run_sh "git rev-parse --verify --quiet ${base@Q} >/dev/null"; then
		warn "git ref '${base}' does not resolve here — falling back to HEAD"
		base="HEAD"
	fi

	# Changed lines that are still in the file, as `<file>:<line>`.
	#
	# The path list comes from `_code_paths`, not from `PROJECT_SOURCE_DIRS`
	# directly: those are subdirectories only, so a theme's `functions.php` was
	# not merely unlinted, it was invisible to this gate.
	local scope
	scope="$(_code_paths | tr '\n' ' ')"
	local targets
	targets="$(run_sh "git diff -U0 --diff-filter=AM ${base@Q} -- $scope | awk '
		/^\\+\\+\\+ b\\// { file = substr(\$0, 7); next }
		/^@@/ { if (match(\$0, /\\+[0-9]+/)) { ln = substr(\$0, RSTART + 1, RLENGTH - 1) + 0 } next }
		/^\\+/ { print file \":\" ln; ln++; next }
		/^-/  { next }
		{ if (ln) ln++ }
	'" | sort -u)"

	if [[ -z "$targets" ]]; then
		info "no changed line in ${scope} — nothing to check"
		return 0
	fi

	# Two passes, because the first one answers "how much is there to check"
	# and the second one spends the budget. Counting every changed line instead
	# made the cap message read "12 checked of 2310" on a diff that was almost
	# entirely comments, which is a report about nothing.
	local candidates=""
	local -A is_classified=() class_reason=()
	local target file line original pattern replacement marker class
	while read -r target; do
		[[ -n "$target" ]] || continue
		file="${target%:*}"
		line="${target##*:}"
		original="$(sed -n "${line}p" "$PROJECT_ROOT/$file" 2>/dev/null || true)"
		[[ -n "$original" ]] || continue
		# The classification, read from the line, and the code the pattern is
		# chosen from — see `_counterfactual_marker` and `_counterfactual_code`
		# for why the reason is not allowed to pick the substitution.
		marker="$(_counterfactual_marker "$original" || true)"
		if [[ -n "$marker" ]]; then
			class="${marker%%$'\t'*}"
			is_classified["${file}:${line}"]="$class"
			class_reason["${file}:${line}"]="${marker#*$'\t'}"
		fi
		while IFS= read -r pattern && IFS= read -r replacement; do
			[[ -n "$pattern" ]] || continue
			if [[ "$(_counterfactual_code "$original")" == *"$pattern"* ]]; then
				candidates="${candidates}${file}:${line}"$'\t'"${pattern}"$'\t'"${replacement}"$'\n'
				break
			fi
		done < <(_counterfactual_patterns)
	done <<< "$targets"

	if [[ -z "$candidates" ]]; then
		info "no changed line in ${scope} carries a substitution — nothing to check"
		return 0
	fi

	local substitutable
	substitutable="$(printf '%s' "$candidates" | grep -c . || true)"

	# Only the lines the suite actually executed.
	#
	# Infection does the same, and for the same reason: a mutation on a line
	# nothing runs is not a weak assertion, it is no test at all, and reporting
	# it as a survivor hides the difference between "your suite is weak" and
	# "your suite is absent". Measured on zenpress: without this filter the
	# command reported 12 survivors out of 12 and was unusable as a gate.
	local coverage_dir=".cache/counterfactual-coverage"
	run_sh "rm -rf ${coverage_dir@Q} && mkdir -p ${coverage_dir@Q}"
	step "Coverage (${config}) — the check only asks about lines the suite ran"

	local prefix=""
	if [[ -f "$PROJECT_ROOT/.config/wp-tests.env" ]]; then
		prefix="set -a; . ./.config/wp-tests.env; set +a; \
			export WP_TESTS_DIR=\"\$PWD/\$WP_TESTS_DIR\" \
			       WP_CORE_DIR=\"\$PWD/\$WP_CORE_DIR\" \
			       TMPDIR=\"\$PWD/\$TMPDIR\";"
	fi

	# A failing suite makes every mutation look killed, which is the one way
	# this gate could report something confidently and wrongly.
	#
	# Bounded, and the two failure modes are told apart. A run that never
	# returns left the hook sitting there with nothing on screen to explain it —
	# over thirty minutes on a theme, killed by hand — and reporting that as
	# "the suite does not pass" would send someone to debug a suite that is
	# fine. `timeout` is GNU coreutils and present in every image the harness
	# supports; 124 is its "timed out" status.
	local coverage_timeout="${HARNESS_COVERAGE_TIMEOUT:-600}"
	local coverage_status=0
	run_sh "${COVERAGE_EXPORT} ${prefix} timeout ${coverage_timeout} php ${COVERAGE_FLAGS[*]} vendor/bin/phpunit \
		--configuration=${config@Q} \
		--coverage-xml=${coverage_dir@Q} \
		--log-junit=${coverage_dir@Q}/junit.xml" </dev/null || coverage_status=$?

	if [[ "$coverage_status" -eq 124 ]]; then
		fail "the coverage run did not finish in ${coverage_timeout}s.
  Not slow — stuck: the same suite passes in seconds without --coverage-xml,
  and under it the PHP process disappears without printing a word.
  Raise the bound with HARNESS_COVERAGE_TIMEOUT=<seconds> once the cause is
  known. Until it is, this check cannot say which lines the suite ran, and
  guessing would be worse than not checking."
	fi
	if [[ "$coverage_status" -ne 0 ]]; then
		fail "the suite does not pass, so a surviving mutation would mean nothing.
  Fix it first: bin/harness ${suite}"
	fi

	local -A is_covered=() covered_by=()
	local pair name tests
	while read -r pair; do
		[[ -n "$pair" ]] || continue
		is_covered["$pair"]=1
	done < <(_covered_lines "$coverage_dir")

	# The same report, read for its other half: which tests cover each line.
	#
	# PHPUnit writes `<covered by="Class::method"/>` inside the `<line>` it
	# covers. Nothing used it, and it is what makes running the whole suite for
	# every substitution unnecessary — measured on `updatronix-pro`, whose 148
	# tests take 33 s under `@runTestsInSeparateProcesses`, so twelve
	# substitutions cost twelve suites. Infection has the same optimisation
	# (`--only-covering-test-cases`); this is the counterfactual's.
	while IFS=$'\t' read -r pair tests; do
		[[ -n "$pair" ]] || continue
		covered_by["$pair"]="$tests"
	done < <(_covering_tests "$coverage_dir")

	local covered_candidates="" covered_total=0
	while IFS=$'\t' read -r target pattern replacement; do
		[[ -n "$target" ]] || continue
		[[ -n "${is_covered[$target]:-}" ]] || continue
		covered_candidates="${covered_candidates}${target}"$'\t'"${pattern}"$'\t'"${replacement}"$'\n'
		covered_total=$(( covered_total + 1 ))
	done <<< "$candidates"

	printf '  %s substitutable changed line(s), %s of them executed by the suite\n' \
		"$substitutable" "$covered_total"

	if [[ "$covered_total" -eq 0 ]]; then
		fail "the diff changes ${substitutable} line(s) of code the suite never runs.
  There is no test to disagree with them, so this is not a passing gate: it is
  a coverage finding. Infection mutates class methods only, and none of the
  changed lines are both substitutable and executed.
  See .agents/skills/test-author/SKILL.md."
	fi

	local limit="${HARNESS_COUNTERFACTUAL_MAX:-12}"
	local total="$covered_total"
	local checked=0 killed=0 survived=0 skipped=0 classified=0
	local narrow=0 wide=0 fallbacks=0

	local work
	work="$(mktemp -d)"
	# `set -e` means any early exit below would otherwise leave a mutated file
	# behind, and a signal is the other way out of this command. One handler
	# covers the normal exit, the three catchable signals and the restore; the
	# journal is what covers the one it cannot (`kill -9`) — the next run
	# repairs the tree from it before it checks anything.
	# shellcheck disable=SC2064
	trap "_counterfactual_recover; rm -rf '$work'" EXIT INT TERM HUP

	while IFS=$'\t' read -r target pattern replacement; do
		[[ -n "$target" ]] || continue
		[[ "$checked" -lt "$limit" ]] || break

		file="${target%:*}"
		line="${target##*:}"

		# The pre-image is read here rather than reused from the candidate pass,
		# because the pass that builds `covered_candidates` keeps only the three
		# fields the loop consumes.
		local pre_image substituted
		pre_image="$(sed -n "${line}p" "$PROJECT_ROOT/$file" 2>/dev/null || true)"

		# `sed` needs `&` and the delimiter escaped in the replacement. Without
		# this, `&&` becomes "the whole match repeated" and the mutation is not
		# the one that was intended.
		local escaped escaped_pat
		escaped="$(_sed_replacement "$replacement")"
		escaped_pat="${pattern//|/\\|}"

		# What the substitution will produce, computed on the string *before*
		# the project's file changes. The journal needs both halves so the next
		# run can tell our edit from someone else's, and it cannot be written
		# after the edit without leaving a window with no journal at all.
		substituted="$(printf '%s\n' "$pre_image" | sed "s|${escaped_pat}|${escaped}|" 2>/dev/null || true)"
		if [[ -z "$substituted" || "$substituted" == "$pre_image" ]]; then
			# `sed` produced the line unchanged, so there is nothing to check and
			# nothing to put back.
			continue
		fi

		cp "$PROJECT_ROOT/$file" "$work/current"
		_counterfactual_journal_write "$file" "$line" "$substituted" "$pre_image"

		if ! sed -i "${line}s|${escaped_pat}|${escaped}|" "$PROJECT_ROOT/$file" 2>/dev/null; then
			cp "$work/current" "$PROJECT_ROOT/$file"
			_counterfactual_journal_clear
			continue
		fi

		# A mutation that does not parse proves nothing: the suite would fail
		# for a reason unrelated to the assertion. Discarded, not counted.
		if ! run_sh "php -l ${file@Q} >/dev/null 2>&1" </dev/null; then
			cp "$work/current" "$PROJECT_ROOT/$file"
			_counterfactual_journal_clear
			skipped=$(( skipped + 1 ))
			continue
		fi

		checked=$(( checked + 1 ))
		# `</dev/null` is load-bearing, not tidiness. This runs a command
		# inside a `while read` loop reading from a here-string, and a child
		# that reads stdin consumes the loop's remaining input: the first
		# version checked exactly one line and reported it as the whole run.
		local classification="${is_classified[$target]:-}"
		local status=0
		if _run_covering_tests "$target" "$config" "$prefix"; then
			status=0
		else
			status=$?
		fi
		if [[ "$status" -eq 0 ]]; then
			if [[ -n "$classification" ]]; then
				# A survivor whose line says it is an equivalent mutation. The
				# finding is real — nothing in the suite depends on the line —
				# but it is not a weak test, and the gate is not the place to
				# re-litigate it. Counted apart, and the claim is printed.
				printf '  %-46s %s  %s\n' "${file}:${line}" "$pattern -> $replacement" "CLASSIFIED equivalent"
				printf '  %-46s %s\n' "" "— ${class_reason[$target]}"
				classified=$(( classified + 1 ))
			else
				printf '  %-46s %s  %s\n' "${file}:${line}" "$pattern -> $replacement" "SURVIVED"
				survived=$(( survived + 1 ))
			fi
		else
			killed=$(( killed + 1 ))
			if [[ -n "$classification" ]]; then
				# The marker claims the twin is unobservable and the suite just
				# killed it. Not a failure — a kill is the gate working — but a
				# classification that is wrong is worth the line, because the
				# next reader will believe it.
				printf '  %-46s %s  %s\n' "${file}:${line}" "$pattern -> $replacement" "KILLED (the marker claims equivalent — it is stale)"
			fi
		fi

		cp "$work/current" "$PROJECT_ROOT/$file"
		_counterfactual_journal_clear
	done <<< "$covered_candidates"

	printf '\n  %s checked of %s executed changed line(s): %s killed, %s survived' \
		"$checked" "$total" "$killed" "$survived"
	[[ "$classified" -gt 0 ]] && printf ', %s classified equivalent' "$classified"
	[[ "$skipped" -gt 0 ]] && printf ', %s not valid PHP' "$skipped"
	printf '\n'
	rm -f "$PROJECT_ROOT/$COUNTERFACTUAL_JUNIT_REL"

	# Which suite answered each substitution. Reported because the saving is
	# invisible otherwise — and because a run that fell back is a run that cost
	# what it used to, which is worth knowing rather than assuming.
	if [[ "$checked" -gt 0 ]]; then
		printf '  %s ran the covering tests alone, %s ran the whole suite\n' \
			"$narrow" "$wide"
	fi
	if [[ "$fallbacks" -gt 0 ]]; then
		warn "${fallbacks} substitution(s) fell back to the whole suite: the coverage
  report named no test PHPUnit could select for the line. The suite that runs
  nothing exits non-zero, which this command would count as a kill, so the
  whole suite is asked instead. See .cache/counterfactual-coverage."
	fi

	# A cap that quietly leaves work undone is the same trap as a skipped test,
	# and it has to be said before the failure or it is never read.
	if [[ "$checked" -lt "$total" ]]; then
		warn "only ${checked} of the ${total} executed changed line(s) were checked.
  Re-run with HARNESS_COUNTERFACTUAL_MAX=${total} to cover the whole diff."
	fi

	if [[ "$survived" -gt 0 ]]; then
		fail "${survived} mutation(s) survived: the suite runs that line and still
  passes with it changed, so nothing it asserts depends on it. That is the
  finding this gate exists to produce — see
  .agents/skills/test-author/SKILL.md.
  If the twin cannot change behaviour for any operand this line can hold it is
  an equivalent mutation, not a weak test: say so on the line with
  \`// counterfactual: equivalent — <reason>\` and this gate will report it as
  classified instead of failing. And if the finding looks impossible, check for
  a journal first: a run killed mid-substitution leaves its edit in the tree at
  ${COUNTERFACTUAL_JOURNAL_REL}, and the next run restores it."
	fi
}

# The journal that makes a killed run recoverable.
#
# This command edits a project's source file, runs a suite, and puts the file
# back. A trap covers the signals; nothing covers SIGKILL, and nothing covers
# the machine going away. Measured in the raise this round comes from: a
# `(bool) preg_match(` became `(int) preg_match(` in a project's tree when a run
# was killed inside that window, and the next `lint` reported a finding that did
# not exist, then the next `counterfactual` a survivor that was not one. Both
# were chased before the cause was found, and the cause was nowhere near the
# symptom.
#
# So the pre-image goes down here **before** the project's file is touched, and
# the next run restores it before it checks anything. Four lines, fixed order:
# the file, the line number, the line the substitution produced, and the line it
# replaced. None of them can contain a newline, and the file is written whole
# and renamed into place, so a half-written journal is not a state this reaches.
COUNTERFACTUAL_JOURNAL_REL=".cache/counterfactual-journal"
# Where a filtered run's JUnit log goes, so the runtime can tell whether the
# `--filter` it built selected anything. Inside the project, because the path is
# read by the PHPUnit process in the container and by this script outside it.
COUNTERFACTUAL_JUNIT_REL=".cache/counterfactual-junit.xml"

_counterfactual_journal_path() {
	printf '%s/%s' "$PROJECT_ROOT" "$COUNTERFACTUAL_JOURNAL_REL"
}

# $1 file (relative to the project), $2 line, $3 substituted, $4 pre-image.
_counterfactual_journal_write() {
	local path tmp
	path="$(_counterfactual_journal_path)"
	mkdir -p "$(dirname "$path")"
	tmp="${path}.$$"
	printf '%s\n%s\n%s\n%s\n' "$1" "$2" "$3" "$4" > "$tmp"
	mv -f "$tmp" "$path"
}

_counterfactual_journal_clear() {
	rm -f "$(_counterfactual_journal_path)"
}

# The replacement text for a `sed s|…|…|`: backslash, `&` and the delimiter are
# the three the language reserves, and all three occur in PHP.
_sed_replacement() {
	local out="$1"
	out="${out//\\/\\\\}"
	out="${out//&/\\&}"
	out="${out//|/\\|}"
	printf '%s' "$out"
}

# Put the tree back the way a killed run found it — and say so.
#
# A silent repair would be worse than none: a file that changed without its
# owner changing it is the other half of the defect the journal exists for.
# Every path here reports, and the two that cannot decide leave the file alone
# rather than guessing.
_counterfactual_recover() {
	local path file line mutated original current
	path="$(_counterfactual_journal_path)"
	[[ -f "$path" ]] || return 0

	# `|| true` on the group: a short journal is handled below, not by `set -e`
	# in the middle of a trap.
	{ IFS= read -r file; IFS= read -r line; IFS= read -r mutated; IFS= read -r original; } < "$path" || true

	if [[ -z "${file:-}" || -z "${line:-}" || -z "${mutated:-}" || -z "${original:-}" ]]; then
		warn "a counterfactual journal is present but unreadable: ${COUNTERFACTUAL_JOURNAL_REL}"
		warn "It names no pre-image, so nothing was restored. Remove it once the tree is"
		warn "known good: rm -f ${COUNTERFACTUAL_JOURNAL_REL}"
		return 0
	fi

	if [[ ! -f "$PROJECT_ROOT/$file" ]]; then
		warn "a counterfactual journal names ${file}, which is not in this project any more."
		warn "Dropping it: ${COUNTERFACTUAL_JOURNAL_REL}"
		rm -f "$path"
		return 0
	fi

	current="$(sed -n "${line}p" "$PROJECT_ROOT/$file" 2>/dev/null || true)"
	if [[ "$current" == "$mutated" ]]; then
		if sed -i "${line}s|.*|$(_sed_replacement "$original")|" "$PROJECT_ROOT/$file"; then
			info "restored ${file}:${line} — a previous counterfactual run was killed mid-substitution"
			rm -f "$path"
		else
			warn "could not restore ${file}:${line}. The pre-image is still in"
			warn "${COUNTERFACTUAL_JOURNAL_REL}."
		fi
	elif [[ "$current" == "$original" ]]; then
		info "${file}:${line} is already the pre-image — the killed run had put it back"
		rm -f "$path"
	else
		warn "${file}:${line} is neither the journal's pre-image nor its substitution,"
		warn "so it was left alone — it has been edited since the killed run."
		warn "Remove the journal once the tree is known good: rm -f ${COUNTERFACTUAL_JOURNAL_REL}"
	fi
	return 0
}

# The classification marker: `// counterfactual: equivalent — <reason>`.
#
# `test-author` requires every survivor to be classified as equivalent,
# unreachable or a gap, and to write the classification where the next person
# finds it. The gate offered no such place, so a correctly classified
# equivalent failed the gate and the classification went nowhere. Sixteen of
# the substitution patterns have a shape where the twin differs; the rest are
# observationally identical on the operand the strict rules push you toward,
# and no test can kill them.
#
# Only `equivalent` is accepted. A `gap` is a missing test and has to fail; an
# `unreachable` line is what the coverage filter already answers for. The
# marker is a claim, so the reason is echoed — a reviewer sees it or fails to.
#
# It has to be on the changed line itself: the substitution happens there, and
# a marker on its own line above has nothing to substitute.
_counterfactual_marker() {
	local line="$1" rest class reason
	[[ "$line" == *counterfactual:* ]] || return 0
	rest="${line#*counterfactual:}"
	class="${rest#"${rest%%[![:space:]]*}"}"
	class="${class%%[[:space:]]*}"
	[[ "$class" == "equivalent" ]] || return 0
	reason="${rest#"${rest%%[![:space:]]*}"}"
	reason="${reason#"$class"}"
	reason="${reason#"${reason%%[![:space:]]*}"}"
	reason="${reason#—}"
	reason="${reason#--}"
	reason="${reason#-}"
	reason="${reason#"${reason%%[![:space:]]*}"}"
	printf '%s\t%s' "$class" "$reason"
}

# The line without its classification comment.
#
# The reason is prose and may contain any token the substitution list knows —
# "false in the reason" would match the `false` → `true` pattern ahead of the
# `(bool)` the line actually carries. So the pattern is chosen from the code,
# and the reason is not allowed to decide what is mutated. The `//` is required
# to sit immediately before `counterfactual:` so a `https://` in a string
# cannot be mistaken for the comment's start.
_counterfactual_code() {
	printf '%s' "${1%%//[[:space:]]*counterfactual:*}"
}

# Run the substitution against the tests that cover that line, not the suite.
#
# The whole suite is what makes a substitution expensive: 148 tests under
# `@runTestsInSeparateProcesses` take 33 s, so twelve of them took twelve
# suites. The coverage report already answers which tests ran the line, and
# PHPUnit's `--filter` takes their names.
#
# The fallback is not politeness. A `--filter` that selects nothing makes
# PHPUnit exit non-zero, and this command reads a non-zero exit as a *killed*
# mutant — so a mis-built filter would report the gate as satisfied while
# asking no test anything. The JUnit log is read back for that reason: no tests
# in it, and the whole suite runs instead.
#
# Sees `covered_by`, `suite`, `config`, `prefix` and the counters from its only
# caller; bash locals are dynamically scoped, which is what `_explain_no_mutants`
# already relies on.
_run_covering_tests() {
	local target="$1" config="$2" prefix="$3"
	local covering="${covered_by[$target]:-}" ran="" status=0

	if [[ -n "$covering" ]]; then
		rm -f "$PROJECT_ROOT/$COUNTERFACTUAL_JUNIT_REL"
		# `--no-coverage`, as `cmd_test` does: the gate is correctness, not
		# instrumentation, and the config declares coverage, so PHPUnit would
		# print a warning about a driver on every one of these runs.
		#
		# `</dev/null` for the same reason as the call it replaces: a child that
		# reads stdin eats the loop's remaining input.
		if run_sh "${prefix} exec php vendor/bin/phpunit \
			--configuration=${config@Q} \
			--no-coverage \
			--filter=${covering@Q} \
			--log-junit=${COUNTERFACTUAL_JUNIT_REL@Q}" </dev/null >/dev/null 2>&1; then
			status=0
		else
			status=$?
		fi
		ran="$(awk '
			/tests="/ {
				if (match($0, /tests="[0-9]+"/)) { print substr($0, RSTART + 7, RLENGTH - 8); exit }
			}
		' "$PROJECT_ROOT/$COUNTERFACTUAL_JUNIT_REL" 2>/dev/null || true)"
		if [[ "${ran:-0}" -gt 0 ]]; then
			narrow=$(( narrow + 1 ))
			return "$status"
		fi
		fallbacks=$(( fallbacks + 1 ))
	fi

	wide=$(( wide + 1 ))
	"cmd_${suite}" </dev/null >/dev/null 2>&1 || return 1
	return 0
}

cmd_build() {	_require_frontend || {
		info "nothing to build."
		return 0
	}
	step "Assets (@wordpress/scripts)"
	run npm run build
}

cmd_start() {
	step "Assets watch mode"
	run npm start
}

cmd_pot() {
	step "i18n — pot, mo, json, php"
	require_tool wp
	# Paths are relative to the project because every backend lands there. The
	# first version passed PROJECT_REL, which is relative to the WordPress root,
	# and would have resolved to wp-content/plugins/<slug>/wp-content/plugins/<slug>.
	local langs="languages"
	run wp i18n make-pot . "$langs/$PROJECT_TEXT_DOMAIN.pot" \
		--exclude=assets/build,node_modules,vendor,.git,tests
	run wp i18n make-mo "$langs" || true
	run wp i18n make-json "$langs" --no-purge || true
	run wp i18n make-php "$langs" || true
	info "wrote $langs/$PROJECT_TEXT_DOMAIN.pot (+ mo/json/php)"
}

# ---------------------------------------------------------------------------
# packaging
# ---------------------------------------------------------------------------

# The archive is built by `wp dist-archive`, the official command, which reads
# `.distignore` -- the one exclusion list WordPress packaging tools agree on.
#
# This replaces a hand-written packager that existed because `dist-archive` was
# believed uninstallable. The check had been made against `dev-main`, which
# requires WP-CLI ^3.0, and DDEV ships 2.12.0 -- and that is true of v3 and
# false of v2.0.1, which installs and runs correctly here. The conclusion was
# right about the constraint and wrong about the package, and the cost was a
# second exclusion mechanism that had to be kept in agreement with
# `.distignore` by hand.
#
# The install is part of packaging rather than a prerequisite in a README: the
# package lands in the container user's home, which `ddev restart` does not
# preserve, so a documented step is a step that gets skipped once and then
# produces a confusing failure. `HARNESS_DIST_ARCHIVE` overrides the version.
DIST_ARCHIVE_PACKAGE="${HARNESS_DIST_ARCHIVE:-wp-cli/dist-archive-command:v2.0.1}"

_ensure_dist_archive() {
	if run_sh 'wp help dist-archive' >/dev/null 2>&1; then
		return 0
	fi
	info "wp dist-archive is absent; installing ${DIST_ARCHIVE_PACKAGE}."
	run wp package install "$DIST_ARCHIVE_PACKAGE"
}

# Paths that must never appear in a release archive, checked after it is built.
#
# This is a post-condition on the *archive*, not a second exclusion list: it
# does not decide what goes in, it refuses to hand over an archive that leaked.
# It exists because the packager was trusted and should not have been --
# `dist-archive` turns each `.distignore` line into `zip --exclude '*/<line>'`,
# a leading slash survives into the pattern as `*//build/*`, and three Infection
# artefacts shipped inside a release with the command reporting success.
#
# Entries are anchored to the archive's root directory, which `dist-archive`
# derives from the project directory name. `<slug>/build/` is the tooling's
# directory; `<slug>/assets/build/` is the bundle that has to ship. A check on
# the name alone cannot tell those apart -- which is the same defect that made
# the ignore list unreliable, so repeating it here would prove nothing.
_ARCHIVE_NEVER_AT_ROOT=(
	'.agents/'
	'.cache/'
	'.config/'
	'.githooks/'
	'.git/'
	'.harness'
	'artifacts/'
	'assets/src/'
	'bin/'
	'build/'
	'docs/'
	'graft/'
	'node_modules/'
	'test-results/'
	'tests/'
	'vendor/'
	'.distignore'
	'AGENTS.md'
	'composer.json'
	'composer.lock'
	'generatepress-settings-all-2025-06-12.json'
	'generatepress-settings-all-2025-11-26.json'
	'infection.json5'
	'package-lock.json'
	'package.json'
	'phpcs-project.xml'
	'phpcs.xml'
	'phpstan-bootstrap.php'
	'phpstan.neon'
	'screenshot-min.png'
	'workflow.md'
)

# Trees that are never part of a distributable at any depth. The two lists are
# separate because the failure modes are: a tooling directory at the root is a
# missed exclusion, whereas a nested `node_modules` means a dependency was
# vendored into a source tree and will ship inside the bundle.
#
# The match requires a file *inside* the directory, not the directory entry,
# and `vendor` is deliberately absent.
#
# `wp dist-archive` appends `/*` to a `.distignore` line only when that line
# names a directory *at the project root*. A nested `vendor` therefore compiles
# to the bare pattern, which matches the directory entry and not its contents.
# Measured on holdmywp-theme: `inc/plugin-update-checker/vendor/` ships 17
# entries, and it should -- it is a library the theme vendors on purpose.
#
# Checking `vendor` at any depth would fail that archive for being correct,
# which is how a check gets switched off. The project's own Composer install is
# caught by the root-anchored list above, where the name is unambiguous.
_ARCHIVE_NEVER_ANYWHERE=(
	'.cache'
	'artifacts'
	'graft'
	'node_modules'
	'test-results'
	'.git'
)

_verify_archive() {
	local archive="$1" entry listing prefix="${PROJECT_SLUG}/" leaked=()
	[[ -f "$archive" ]] || fail "no archive was written at ${archive}."

	if ! has_tool unzip; then
		warn "unzip is unavailable; the archive was not verified."
		return 0
	fi

	listing="$(unzip -Z1 "$archive" 2>/dev/null || true)"
	if [[ -z "$listing" ]]; then
		fail "the archive at ${archive} is empty or unreadable."
	fi

	for entry in "${_ARCHIVE_NEVER_AT_ROOT[@]}"; do
		if grep -qF -- "${prefix}${entry}" <<< "$listing"; then
			leaked+=("${prefix}${entry}")
		fi
	done
	for entry in "${_ARCHIVE_NEVER_ANYWHERE[@]}"; do
		# A path separator *after* the name, so a directory entry alone does
		# not match and a file inside it does.
		if grep -qE -- "/${entry//./\\.}/[^/]" <<< "$listing"; then
			leaked+=("/${entry}/…")
		fi
	done

	if [[ ${#leaked[@]} -gt 0 ]]; then
		warn "the archive contains files that belong to the development tree:"
		for entry in "${leaked[@]}"; do
			printf '      %s\n' "$entry"
		done
		fail "packaging is not clean; fix .distignore before releasing."
	fi
	# The check names what it refused to let through. A verifier that prints
	# only "verified" is a verifier nobody can tell was looking at the wrong
	# list -- which is how `test-results/` shipped while this line reported
	# "no development files".
	info "verified: $(grep -c . <<< "$listing") entries, none of the $((${#_ARCHIVE_NEVER_AT_ROOT[@]} + ${#_ARCHIVE_NEVER_ANYWHERE[@]})) development paths checked:"
	info "  never at the archive root: ${_ARCHIVE_NEVER_AT_ROOT[*]}"
	info "  never at any depth:        ${_ARCHIVE_NEVER_ANYWHERE[*]}"
}

# Directories moved aside for the duration of the archive, and the trap that
# puts them back.
#
# `wp dist-archive` shells out to `zip -r`, which walks everything it is given
# and honours `--exclude` only while deciding what to *store*. A `.distignore`
# line therefore does not save the walk, and on a project with `node_modules`
# installed that walk is about 70,000 files. Measured on basecoat: 6m15s and
# then the kernel killed it for memory, twice.
#
# `dist-archive` offers no way to prune, and the directory cannot simply be
# deleted -- it is the toolchain. So it is moved out of the tree for the run and
# restored by a trap, which fires on the failure path and on an interrupt as well
# as on success. The archive never contained it; this only stops the walk from
# visiting it.
#
# `HARNESS_ZIP_KEEP=1` skips the move, for a checkout that has already been
# pruned (CI does this) where the walk is cheap.
_ZIP_PRUNED=()
_ZIP_STASH=""

_restore_after_packaging() {
	local name
	for name in "${_ZIP_PRUNED[@]-}"; do
		[[ -n "$name" && -e "$_ZIP_STASH/$name" && ! -e "$PROJECT_ROOT/$name" ]] || continue
		mv "$_ZIP_STASH/$name" "$PROJECT_ROOT/$name"
	done
	_ZIP_PRUNED=()
	[[ -n "$_ZIP_STASH" ]] && rmdir "$_ZIP_STASH" 2>/dev/null || true
	_ZIP_STASH=""
}

_prune_before_packaging() {
	if [[ "${HARNESS_ZIP_KEEP:-0}" != "0" ]]; then
		return 0
	fi
	local name candidates=(node_modules vendor)
	trap '_restore_after_packaging' EXIT INT TERM
	for name in "${candidates[@]}"; do
		[[ -d "$PROJECT_ROOT/$name" ]] || continue
		if [[ -z "$_ZIP_STASH" ]]; then
			# A sibling of the project, not a temp directory: `mv` is atomic
			# within a filesystem and a copy across one, and `node_modules` is
			# tens of thousands of files. It is outside the tree `zip` is given,
			# so the walk cannot see it.
			_ZIP_STASH="$PROJECT_ROOT/../.harness-zip-stash.$$"
			mkdir -p "$_ZIP_STASH"
		fi
		mv "$PROJECT_ROOT/$name" "$_ZIP_STASH/$name"
		_ZIP_PRUNED+=("$name")
	done
	if [[ ${#_ZIP_PRUNED[@]} -gt 0 ]]; then
		info "moved ${_ZIP_PRUNED[*]} aside for the walk; restored afterwards."
	fi
}

cmd_zip() {
	step "Packaging (wp dist-archive)"
	require_tool wp
	_ensure_dist_archive
	local archive="${PROJECT_SLUG}.zip"
	rm -f "$PROJECT_ROOT/$archive"
	_prune_before_packaging
	# Relative paths, and the project as the working directory: `dist-archive`
	# derives the archive's root directory from the path it is given, so
	# absolute paths put the plugin inside a tree named after every parent
	# directory.
	run wp dist-archive . "$archive" || {
		_restore_after_packaging
		fail "packaging failed."
	}
	_restore_after_packaging
	_verify_archive "$PROJECT_ROOT/$archive"
	info "wrote $archive"
}

cmd_pcp() {
	step "Plugin Check"
	# WordPress.org reviews themes with a different tool, so this cannot run on
	# one. Failing instead made `npm run test:all` unsatisfiable for every
	# theme — the same trap as a missing test suite, and the same answer: say
	# so, name what does apply, and do not fail.
	if [[ "$PROJECT_KIND" != "plugin" ]]; then
		info "${PROJECT_SLUG} is a ${PROJECT_KIND}; Plugin Check applies to plugins."
		info "The PHP standards still apply: bin/harness lint:wpcs."
		return 0
	fi
	require_tool wp

	# Development trees and files are not part of the distributable, so scanning
	# them reports on a zip that does not exist. The hand-written
	# `.config/local-wp-cli.sh` carried such a list and the first generated
	# runtime dropped it, which made Plugin Check complain about `.agents/`,
	# `.githooks/` and `AGENTS.md` — the harness's own files.
	#
	# `.cache/` was missing from that list and it is the one that matters: it
	# holds the WordPress test stack `setup` installs, 219 MB and 4774 files on
	# updatronix, and Plugin Check walks all of it. `bin/harness pcp` never
	# returned on any provisioned project — 900 s of nothing — while the same
	# command with `.cache` added finished in under two minutes and passed.
	# `artifacts/` and `test-results/` are Playwright's, and the archive itself
	# is named by slug, because `bin/harness zip` leaves it at the project root.
	local exclude_dirs=".git,.github,.agents,.reasonix,.harness,.githooks,.config,.claude,.cursor,.vscode,graft,bin,tests,vendor,node_modules,build,assets/src,.cache,artifacts,test-results"
	local exclude_files="workflow.md,AGENTS.md,infection.json5,.distignore,.ignore,.gitignore,.gitattributes,.editorconfig,.mcp.json,${PROJECT_SLUG}.zip"

	# Only two codes are silenced outright, and both because this plugin exists
	# to use them: it is an update manager, so touching the update APIs is the
	# feature, not a defect. Everything else is reported.
	run wp plugin check "$PROJECT_SLUG" \
		--exclude-directories="$exclude_dirs" \
		--exclude-files="$exclude_files" \
		--ignore-codes=plugin_updater_detected,update_modification_detected
}

cmd_package() {
	cmd_build
	cmd_pot
	cmd_zip
}

cmd_verify() {
	step "pre-push gate: ${PROJECT_SLUG}"
	cmd_lint
	# The front-end gates were absent from this hook, which is why 674 ESLint
	# problems sat in two projects while every recorded gate run was green: the
	# gate ran PHP and the tests, and `npm run lint` was never called by
	# anything but `npm run test:all`, which nothing called either.
	cmd_lint_js
	cmd_lint_css
	# `cmd_format` is deliberately absent: `wp-scripts format` always writes, and
	# a gate must not edit the tree it is judging. It does not need to be here --
	# `npm run lint` runs `prettier/prettier` as an error through ESLint.
	cmd_build
	# The suite the project has, not the one it "should" have — see cmd_suite.
	# A theme has none: the guard returns before the dispatch, so `verify` is
	# lint, lint:js, lint:css and the build for a theme, and the four plus the
	# suite for a plugin.
	_require_test_layer || return 0
	if [[ "$(cmd_suite)" == "integration" ]]; then
		cmd_integration
	else
		cmd_test
	fi
}

# Which suite command runs the tests this project actually has.
#
# A hook cannot guess: `test` means the unit suite and `integration` means the
# other, and a project whose tests are all integration fails `test` with "no
# *Test.php file" — which is the guard doing its job, not a red build. Without
# this the hook ran the wrong one and made the gate impossible to satisfy.
cmd_suite() {
	_require_test_layer || return 0
	local config
	config="$(_tests_config || true)"
	if [[ -z "$config" ]]; then
		fail "no PHPUnit config declares a directory containing tests."
	fi
	if [[ "$config" == *integration* ]]; then
		printf 'integration\n'
	else
		printf 'test\n'
	fi
}

cmd_matrix() {
	local versions="${HARNESS_PHP_MATRIX:-8.1 8.2 8.3 8.4}"
	if [[ "$BACKEND" != "ddev" ]]; then
		fail "the PHP matrix requires DDEV (it restarts the project per version)"
	fi
	local current
	current="$(cd "$WP_ROOT" && ddev config --json 2>/dev/null | sed -n 's/.*"php_version" *: *"\([^"]*\)".*/\1/p' | head -1)"
	for version in $versions; do
		step "PHP ${version}"
		(cd "$WP_ROOT" && ddev config --php-version="$version" >/dev/null && ddev restart >/dev/null)
		cmd_test || warn "PHP ${version}: unit suite failed"
	done
	step "restoring PHP ${current:-8.4}"
	(cd "$WP_ROOT" && ddev config --php-version="${current:-8.4}" >/dev/null && ddev restart >/dev/null)
}

# ---------------------------------------------------------------------------
# reporting
# ---------------------------------------------------------------------------

cmd_env() {
	printf 'project     %s (%s)\n' "$PROJECT_SLUG" "$PROJECT_KIND"
	printf 'root        %s\n' "$PROJECT_ROOT"
	printf 'wp root     %s\n' "$WP_ROOT"
	printf 'relative    %s\n' "$PROJECT_REL"
	printf 'backend     %s\n' "$BACKEND"
	printf 'harness     %s\n' "$HARNESS_VERSION"
	printf 'text domain %s\n' "$PROJECT_TEXT_DOMAIN"
	printf 'php min     %s\n' "$PROJECT_PHP_MIN"
}

cmd_doctor() {
	cmd_env
	step "tools in the '$BACKEND' backend"
	local tool
	for tool in php composer wp node npm git; do
		if has_tool "$tool"; then
			printf '  ok   %-10s %s\n' "$tool" "$(run_sh "$tool --version 2>/dev/null | head -1")"
		else
			printf '  MISS %-10s\n' "$tool"
		fi
	done
	step "graft"
	if _resolve_graft >/dev/null; then
		printf '  ok   %s\n' "$(_resolve_graft)"
		[[ -d "$PROJECT_ROOT/graft" ]] && printf '  index present\n' || printf '  no index (run: bin/harness graft build)\n'
	else
		printf '  MISS graft (nvm Node toolchain not found)\n'
	fi
	step "harness-managed files"
	if [[ -f "$PROJECT_ROOT/.harness/manifest.json" ]]; then
		printf '  manifest present (harness %s)\n' \
			"$(sed -n 's/.*"harness_version": *"\([^"]*\)".*/\1/p' "$PROJECT_ROOT/.harness/manifest.json" | head -1)"
	else
		printf '  no manifest — run `harness sync` from the generator checkout\n'
	fi
	# Reported because it is invisible otherwise: the hooks are committed, so the
	# directory looks wired whether or not git is pointed at it.
	if [[ -d "$PROJECT_ROOT/.githooks" ]]; then
		local hooks_path
		hooks_path="$(cd "$PROJECT_ROOT" && git config --local --get core.hooksPath 2>/dev/null || true)"
		if [[ "$hooks_path" == ".githooks" ]]; then
			printf '  git hooks wired (core.hooksPath = .githooks)\n'
		else
			printf '  git hooks NOT wired — run: bin/harness setup\n'
		fi
	fi
	# A killed `counterfactual` leaves its substitution in a project's file, and
	# every gate after that reports on a tree nobody edited: the next `lint` a
	# phantom finding, the next `counterfactual` a phantom survivor. Reported
	# here because this is the only command that runs before the gates and asks
	# nothing of the diff — and because the symptom is two directories away from
	# the cause, which is what made it expensive the first time.
	if [[ -f "$PROJECT_ROOT/$COUNTERFACTUAL_JOURNAL_REL" ]]; then
		local journal_file journal_line
		journal_file="$(sed -n '1p' "$PROJECT_ROOT/$COUNTERFACTUAL_JOURNAL_REL" 2>/dev/null || true)"
		journal_line="$(sed -n '2p' "$PROJECT_ROOT/$COUNTERFACTUAL_JOURNAL_REL" 2>/dev/null || true)"
		step "counterfactual journal"
		printf '  STALE %s\n' "$COUNTERFACTUAL_JOURNAL_REL"
		if [[ -n "$journal_file" ]]; then
			printf '  it names %s%s\n' "$journal_file" "${journal_line:+:$journal_line}"
		fi
		printf '  A previous `counterfactual` run was killed while it had a substitution in\n'
		printf '  the tree, so a source file may not be what git last recorded.\n'
		printf '  Repair: bin/harness counterfactual — it restores the pre-image from the\n'
		printf '  journal before it reads the diff.\n'
	fi
	# Reported because nothing else does. `composer install` prints advisories
	# while it works and then scrolls them away, and no gate reads them: a
	# project can carry a known-vulnerable dependency through every green run.
	# Two of the seven did -- one advisory on zenpress, four on peashup-theme.
	#
	# `doctor` reports and never fails, so this says what it found rather than
	# refusing to continue.
	if [[ -f "$PROJECT_ROOT/package-lock.json" && -d "$PROJECT_ROOT/node_modules" ]]; then
		step "npm audit"
		local npm_audit
		npm_audit="$(run_sh 'npm audit --omit=dev 2>&1' 2>&1 || true)"
		if grep -qiE "found 0 vulnerabilities" <<< "$npm_audit"; then
			printf '  none in the production tree\n'
		else
			printf '%s\n' "$npm_audit" | grep -iE "vulnerabilit|severity|^[a-z@]" | head -8 | sed 's/^/  /'
		fi
	fi
	if [[ -f "$PROJECT_ROOT/composer.lock" ]]; then
		step "composer audit"
		local audit
		audit="$(run_sh 'composer audit --no-interaction --format=plain' 2>&1 || true)"
		if grep -qiE "no security vulnerability advisories" <<< "$audit"; then
			printf '  none\n'
		else
			printf '%s\n' "$audit" | grep -vE "^$|^>" | head -10 | sed 's/^/  /'
		fi
	fi
}

usage() {
	cat <<EOF
${PROJECT_SLUG} harness ${HARNESS_VERSION} — backend: ${BACKEND:-unresolved}

  bin/harness env                 resolved project + backend
  bin/harness doctor              tool availability, graft, manifest
  bin/harness exec <cmd...>       run anything in the project backend

  bin/harness php|composer|wp|node|npm|npx <args...>
  bin/harness graft <args...>     code graph (runs on the host, needs nvm Node)

  bin/harness lint                WPCS + PHPStan
  bin/harness lint:wpcs           WPCS only
  bin/harness lint:fix            WPCS autofix
  bin/harness lint:files <files…> WPCS on named files (used by the git hooks)
  bin/harness test:js             Jest, through @wordpress/scripts
  bin/harness e2e [args]         Playwright against the local site. Creates a
                               dedicated admin on first run; credentials come
                               from .config/wp-tests.env
  bin/harness antipatterns <files…>
                               tests that cannot fail -- literal assertions,
                               skipped without a reason, mocks asserted on
  bin/harness prose [--base=<ref>]
                               comments that changed while the code did not.
                               Reports, never fails
                                  scan tests for assertions that cannot fail
  bin/harness lint:js|lint:css|format
  bin/harness build|start         assets via @wordpress/scripts
  bin/harness test                unit suite
  bin/harness integration [args]  integration suite (real WordPress)
  bin/harness suite               the suite command this project's tests need
  bin/harness setup [--force]     install dependencies + the WP test stack
  bin/harness coverage [--suite=integration]
  bin/harness mutation            Infection on the diff (anti-tautology)
  bin/harness counterfactual      mutation by substitution, for code Infection
                                  cannot reach (global functions)
  bin/harness pcp                 Plugin Check
  bin/harness verify              the pre-push gate

  WP_MULTISITE=1 bin/harness integration   also run the multisite suite

  bin/harness pot                 i18n: pot + mo + json + php
  bin/harness zip                 distributable archive
  bin/harness package             build + pot + zip
  bin/harness matrix              run the unit suite on PHP 8.1..8.4 (DDEV only)
EOF
}

# ---------------------------------------------------------------------------
main() {
	_init
	local command="${1:-}"
	shift || true
	case "$command" in
	"") usage ;;
	env) cmd_env ;;
	doctor) cmd_doctor ;;
	exec) run "$@" ;;
	php | composer | wp | node | npm | npx) require_tool "$command"; run "$command" "$@" ;;
	graft) cmd_graft "$@" ;;
	lint) cmd_lint ;;
	lint:wpcs) cmd_lint_wpcs ;;
	lint:fix) cmd_lint_fix ;;
	lint:files) cmd_lint_files "$@" ;;
	antipatterns) cmd_antipatterns "$@" ;;
	test:js) cmd_test_js ;;
	e2e) cmd_e2e "$@" ;;
	prose) cmd_prose "$@" ;;
	lint:js) cmd_lint_js ;;
	lint:css) cmd_lint_css ;;
	format) cmd_format ;;
	build) cmd_build ;;
	start) cmd_start ;;
	test) cmd_test ;;
	integration) cmd_integration ;;
	suite) cmd_suite ;;
	setup) cmd_setup "$@" ;;
	coverage) cmd_coverage ;;
	mutation) cmd_mutation ;;
	counterfactual) cmd_counterfactual ;;
	pcp) cmd_pcp ;;
	pot) cmd_pot ;;
	zip) cmd_zip ;;
	package) cmd_package ;;
	verify) cmd_verify ;;
	matrix) cmd_matrix ;;
	-h | --help | help) usage ;;
	*) fail "unknown command: $command (try: bin/harness help)" ;;
	esac
}

main "$@"
