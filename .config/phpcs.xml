<?xml version="1.0"?>
<!--
	Generated by wp-harness 0.1.0. OWNED file: edits are
	overwritten by `harness sync`.

	This ruleset owns the *standard*. The paths are passed by `bin/harness`,
	which derives them from the project layout — a project that adds `src/`
	next year should not also need this file edited.
-->
<ruleset name="zenpress">
	<description>WordPress Coding Standards for zenpress.</description>

	<!--
		The fleet's standard, one line per standard (docs/TOOLCHAIN.md).
		`WordPress` is Core + Extra + Docs; the other two are the strict packages
		the floor installs, and a package that is installed and never referenced
		is a package nothing runs — which is what these two were.

		`testVersion` below only means anything because PHPCompatibilityWP is
		referenced here. It is a standard, not a config that switches on.
	-->
	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>
	<rule ref="VariableAnalysis"/>

	<!-- Declared floor, so PHPCompatibility checks against it. -->
	<config name="testVersion" value="8.1-"/>

	<!--
		PHP only.

		PHP_CodeSniffer ships with a default extension list that includes `js`
		and `css`, so without this the WordPress standard is applied to
		JavaScript and stylesheets. It reports things that are not defects —
		`OperatorSpacing` and `PEAR.Functions.FunctionCallSignature` on `.js`
		files, and a tokenizer error on a `.css` — and it reports them against
		the wrong standard: JavaScript belongs to ESLint and CSS to Stylelint,
		both of which this project already runs through `lint:js` and
		`lint:css`.

		Measured on holdmywp-theme: 180 of its 358 remaining violations were in
		files PHP_CodeSniffer should never have opened.
	-->
	<arg name="extensions" value="php"/>

	<!-- One text domain, the slug. -->
	<config name="text_domain" value="zenpress"/>

	<!-- Warnings are informational; only errors fail the gate. -->
	<config name="ignore_warnings_on_exit" value="1"/>

	<!-- Generated and vendored trees. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/.config/*</exclude-pattern>
	<exclude-pattern>*/assets/build/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<!--
		The unit bootstrap stubs WordPress functions. It is test scaffolding, not
		plugin code, and it is deliberately kept out of the gate.
	-->
	<exclude-pattern>*/tests/bootstrap.php</exclude-pattern>

	<!--
		Test doubles for WordPress itself. Nothing here is plugin code, and WPCS
		on a synthesised `WP_Error` reports on WordPress's style rather than
		ours. DESIGN section 5 puts these on the list to replace with real
		integration coverage; until then they stay out of the gate.
	-->
	<exclude-pattern>*/tests/stubs/*</exclude-pattern>

	<!-- Directory index placeholder. -->
	<exclude-pattern>*/index.php</exclude-pattern>

	<!-- Harness-owned scripts that run before WordPress is loaded. -->
	<exclude-pattern>*/bin/check-test-antipatterns.php</exclude-pattern>

	<!--
		The project's own exceptions, seeded once by `bin/harness sync` and then
		owned by the project. Kept separate so that adding one does not mean
		fighting this file, which is regenerated on every sync.

		The path is resolved by PHPCS from the working directory, not from this
		file, which is why it is written out in full rather than as a sibling.
		`bin/harness` always runs PHPCS from the project root.
	-->
	<rule ref="./.config/phpcs-project.xml"/>
</ruleset>
