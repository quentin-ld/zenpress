# PHPStan configuration for zenpress.
#
# Generated by wp-harness 0.1.0. OWNED file: edits are overwritten
# by `harness sync`. Put your own parameters and `ignoreErrors` in
# `.config/phpstan-project.neon`, which is included below and is yours.
#
# The level and the three includes are the fleet's floor (docs/TOOLCHAIN.md).
# Raising either is a change to `sources/php/phpstan.neon` in the generator, not
# a change to thirteen project files -- which is what it was, and how three
# plugins came to be on level 6 while four themes were on level 5.
#
# `includes` and `excludePaths` resolve from THIS file's directory, which is why
# they start with `../`.
includes:
    - ../vendor/szepeviktor/phpstan-wordpress/extension.neon
    - ../vendor/phpstan/phpstan-strict-rules/rules.neon
    - ../vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - phpstan-project.neon

parameters:
    level: 8
    # The PHP the code is written for, so PHPStan checks against the project's
    # declared floor rather than against whatever PHP it happens to be running
    # on. Same declaration as `testVersion` in `.config/phpcs.xml`.
    phpVersion: 80100
    # PHPStan's result cache, moved out of the container's `/tmp`.
    #
    # It defaults to `<tmp>/phpstan`, which is already cached and already fast —
    # a warm run is 4.5 s against 30.6 s cold — and which does **not** survive a
    # `ddev rebuild`: the container is recreated, `/tmp` with it, and the next
    # `lint` pays the whole analysis again. `.cache/` is bind-mounted into it,
    # gitignored in every project and excluded from the release archive, so the
    # cache outlives the container and never ships.
    #
    # This is durability, not speed. The 30.6 s -> 4.5 s is PHPStan's own
    # default and is not this line's doing; what this line buys is that the
    # figure survives a rebuild. It still invalidates on a PHP-version change
    # and on any analysed-source change — PHPStan keys on both — so "durable"
    # does not mean "stale-proof".
    #
    # `../` for the same reason `includes` and `excludePaths` above carry it:
    # PHPStan resolves `tmpDir` from THIS file's directory, not from the project
    # root. Measured rather than assumed — `.cache/phpstan` here created
    # `.config/.cache/phpstan`, inside the tracked directory the cache must not
    # land in.
    tmpDir: ../.cache/phpstan
    # Only a project that carries a bootstrap gets the line, so a theme's config
    # never names a file that does not exist.
    bootstrapFiles:
        - phpstan-bootstrap.php
    excludePaths:
        analyseAndScan:
            - ../vendor/*
            - ../node_modules/*
