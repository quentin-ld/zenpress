// Infection — mutation testing for ZenPress.
//
// Generated by wp-harness 0.1.0. OWNED file: edits are
// overwritten by `harness sync`.
//
// This file owns the *paths*. The policy — MSI 70, covered MSI 80, diff-only —
// lives in `bin/harness mutation`, so a threshold can never disagree with
// itself in two places.
//
// Why mutation testing at all: a test that cannot fail is worse than no test,
// because it still reports coverage. Infection changes the code deliberately
// and re-runs the suite. A mutant that survives is a hole in the tests.
//
// Run it on the diff, not the whole project:
//     bin/harness mutation
{
	"$schema": "vendor/infection/infection/resources/schema.json",

	// Derived from the project layout, not configured by hand: a project that
	// adds a `src/` next year should not also need a harness change.
	"source": {
		"directories": ["inc"],
		"excludes": ["vendor", "node_modules", "tests", "assets/build"]
	},

	// Reports land in .cache/, which is gitignored everywhere and, more
	// importantly, is never a name a project also ships.
	//
	// They used to land in build/, and that name is the reason packaging had
	// to carry a hand-written packager: `.distignore` wants to exclude the
	// tooling's build/ without excluding the bundle's `assets/build/`, and
	// `wp dist-archive` cannot express that. It turns every entry into
	// `zip --exclude '*/<entry>'`, and in a zip pattern `*` crosses `/`, so
	// `build` matched `assets/build/*` as well and the compiled CSS and JS
	// stopped shipping. Prefixing the project name did not help either: it
	// makes the pattern `*/<slug>/build/*`, which matched nothing at all.
	//
	// Both directions were tested. The name collision is the defect; moving
	// the reports is the fix.
	"logs": {
		"text": ".cache/infection/infection.log",
		"summary": ".cache/infection/infection-summary.log",
		"json": ".cache/infection/infection.json"
	},

	"mutators": {
		"@default": true
	},

	// Infection looks for `phpunit.xml` at the project root. This fleet keeps
	// it under `.config/`, so the directory is stated rather than discovered.
	// Without it: "Could not locate the files phpunit.xml, phpunit.yml, …".
	"phpUnit": {
		"configDir": ".config"
	},

	// A single hanging test should not cost the whole run its budget.
	"timeout": 20
}
