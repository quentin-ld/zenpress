msgid "Disable prev/next post links in head"
msgstr ""

#: inc/snippets/meta/disable-adjacent-posts.meta.php:16
msgid "Removes rel=\"prev\" and rel=\"next\" tags from the HTML head. Stops WordPress from indicating paginated post relationships for search engines."
msgstr ""

