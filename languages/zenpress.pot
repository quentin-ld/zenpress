#: inc/snippets/meta/disable-application-passwords.meta.php:15
msgid "Disable application passwords"
msgstr ""

#: inc/snippets/meta/disable-application-passwords.meta.php:16
msgid "Turns off application passwords for all users. Do not enable if your site relies on external applications or services that authenticate via the WordPress REST API or XML-RPC using application passwords."
msgstr ""

#: inc/snippets/meta/disable-author-archives.meta.php:15
msgid "Disable author archives"
msgstr ""

#: inc/snippets/meta/disable-author-archives.meta.php:16
msgid "Author archive URLs show a 404 Page Not Found response. Prevents listing all posts by a specific author and hides usernames from the URL structure."
msgstr ""

#: inc/snippets/meta/disable-autosave.meta.php:15
msgid "Disable autosave (classic editor)"
msgstr ""

#: inc/snippets/meta/disable-autosave.meta.php:16
msgid "Disables autosave in the classic editor only. The block editor uses its own autosave mechanism and is not affected."
msgstr ""

#: inc/snippets/meta/disable-capital-p-dangit.meta.php:15
msgid "Disable \"WordPress\" spelling correction"
msgstr ""

#: inc/snippets/meta/disable-capital-p-dangit.meta.php:16
msgid "Stops the capitalization filter that corrects \"Wordpress\" to \"WordPress\" in titles and content. The filter runs on every page load; disabling it removes that processing step."
msgstr ""

#: inc/snippets/meta/disable-dashicons.meta.php:15
msgid "Disable Dashicons (admin icons)"
msgstr ""

#: inc/snippets/meta/disable-dashicons.meta.php:16
msgid "Stops Dashicons (admin icons) from loading for visitors. Logged-in users still see them."
msgstr ""

#: inc/snippets/meta/disable-default-pattern-categories.meta.php:15
msgid "Disable default pattern categories in Site Editor"
msgstr ""

#: inc/snippets/meta/disable-default-pattern-categories.meta.php:16
msgid "Removes default pattern categories from the block inserter in the Site Editor. The patterns themselves remain available but are no longer grouped by category."
msgstr ""

#: inc/snippets/meta/disable-default-pattern-categories.meta.php:17
#: inc/snippets/meta/remove-gutenberg-unwanted-block-patterns.meta.php:17
#: inc/snippets/meta/separate-gutenberg-core-block-styles.meta.php:17
msgid "gutenberg"
msgstr ""

#: inc/snippets/meta/disable-dns-prefetch.meta.php:15
msgid "Disable DNS prefetch"
msgstr ""

#: inc/snippets/meta/disable-dns-prefetch.meta.php:16
msgid "Removes DNS prefetch resource hints from the HTML head. Stops WordPress from instructing browsers to resolve domain names for external services before they are needed."
msgstr ""

#: inc/snippets/meta/disable-emoji-scripts.meta.php:15
msgid "Disable WordPress emoji scripts and styles"
msgstr ""

#: inc/snippets/meta/disable-emoji-scripts.meta.php:16
msgid "Removes emoji detection script, styles, and filters from the front end, back end, feeds, emails, and TinyMCE. Reduces the number of assets loaded on each page."
msgstr ""

#: inc/snippets/meta/disable-jquery-migrate.meta.php:15
msgid "Disable jQuery Migrate script"
msgstr ""

#: inc/snippets/meta/disable-jquery-migrate.meta.php:16
msgid "Disables the jQuery Migrate script on the front end while keeping it loaded in the admin area. Reduces the JavaScript payload for site visitors."
msgstr ""

#: inc/snippets/meta/disable-login-language-selector.meta.php:15
msgid "Disable login language selector"
msgstr ""

#: inc/snippets/meta/disable-login-language-selector.meta.php:16
msgid "Removes the language dropdown from the WordPress login page. The login screen shows the site language without offering a language selection option."
msgstr ""

#: inc/snippets/meta/disable-oembed.meta.php:15
msgid "Disable oEmbed"
msgstr ""

#: inc/snippets/meta/disable-oembed.meta.php:16
msgid "Removes WordPress oEmbed features: auto-discovery links, REST API route, TinyMCE integration, rewrite rules, and the wp-embed script. Embedded content from external sites will no longer display inline."
msgstr ""

#: inc/snippets/meta/disable-password-strength-meter.meta.php:15
msgid "Disable password strength meter"
msgstr ""

#: inc/snippets/meta/disable-password-strength-meter.meta.php:16
msgid "Removes the password strength meter script and styles from the login and profile pages. Users will not see the password strength indicator when creating or changing their password."
msgstr ""

#: inc/snippets/meta/disable-pdf-thumbnails.meta.php:15
msgid "Disable PDF thumbnails"
msgstr ""

#: inc/snippets/meta/disable-pdf-thumbnails.meta.php:16
msgid "Stops WordPress from generating thumbnail image sizes for uploaded PDF files. PDFs remain uploadable but no fallback image is created."
msgstr ""

#: inc/snippets/meta/disable-pingback-trackback.meta.php:15
msgid "Disable pingbacks and trackbacks"
msgstr ""

#: inc/snippets/meta/disable-pingback-trackback.meta.php:16
msgid "Removes the X-Pingback header from HTTP responses, disables pingbacks and trackbacks on new posts, and prevents self-pingbacks. Reduces spam and blocks a potential DDoS amplification vector."
msgstr ""

#: inc/snippets/meta/disable-rest-api.meta.php:15
msgid "Limit REST API to logged-in users"
msgstr ""

#: inc/snippets/meta/disable-rest-api.meta.php:16
msgid "Restricts REST API access to logged-in users only. Unauthenticated visitors receive an error response. This snippet provides three filters for advanced use: zenpress_disable_wp_rest_api_post_var and zenpress_disable_wp_rest_api_server_var allow specific POST keys or request paths to bypass the restriction (for webhooks or third-party integrations), and zenpress_disable_wp_rest_api_error customizes the error message. Use the bypass filters with values that are secret or not guessable, such as a random token passed via POST."
msgstr ""

#: inc/snippets/meta/disable-rss.meta.php:15
msgid "Disable all feeds (RSS, Atom, comments)"
msgstr ""

#: inc/snippets/meta/disable-rss.meta.php:16
msgid "Prevents access to all default feeds — RDF, RSS, RSS2, Atom, and comments feed. Feed links are removed from the HTML head, and feed URL requests redirect to the homepage."
msgstr ""

#: inc/snippets/meta/disable-shortlink.meta.php:15
msgid "Disable shortlink"
msgstr ""

#: inc/snippets/meta/disable-shortlink.meta.php:16
msgid "Removes the shortlink tag from the HTML head and the Link HTTP header. Shortlinks (example.com/?p=123) are no longer advertised."
msgstr ""

#: inc/snippets/meta/disable-wlw-manifest.meta.php:15
msgid "Disable Windows Live Writer link"
msgstr ""

#: inc/snippets/meta/disable-wlw-manifest.meta.php:16
msgid "Removes the Windows Live Writer manifest link from the HTML head. This link was used by the deprecated Windows Live Writer desktop application."
msgstr ""

#: inc/snippets/meta/disable-woocommerce-cart-fragments.meta.php:15
msgid "Disable WooCommerce cart fragments"
msgstr ""

#: inc/snippets/meta/disable-woocommerce-cart-fragments.meta.php:16
msgid "Stops the script that updates the cart count without reloading the page. The cart total no longer updates without a page reload."
msgstr ""

#: inc/snippets/meta/disable-woocommerce-cart-fragments.meta.php:17
#: inc/snippets/meta/disable-woocommerce-scripts-styles.meta.php:17
#: inc/snippets/meta/disable-woocommerce-stripe-scripts.meta.php:17
#: inc/snippets/meta/disable-woocommerce-widgets.meta.php:17
#: inc/snippets/meta/hide-woocommerce-version.meta.php:17
#: inc/snippets/meta/remove-woocommerce-patterns.meta.php:17
msgid "woocommerce"
msgstr ""

#: inc/snippets/meta/disable-woocommerce-scripts-styles.meta.php:15
msgid "Disable WooCommerce scripts and styles on non-shop pages"
msgstr ""

#: inc/snippets/meta/disable-woocommerce-scripts-styles.meta.php:16
msgid "Dequeues WooCommerce styles and scripts on pages where WooCommerce is not active, such as the homepage, blog posts, and custom pages. WooCommerce pages are not affected."
msgstr ""

#: inc/snippets/meta/disable-woocommerce-stripe-scripts.meta.php:15
msgid "Disable Stripe scripts on product and cart pages"
msgstr ""

#: inc/snippets/meta/disable-woocommerce-stripe-scripts.meta.php:16
msgid "Stops Stripe-related scripts from loading on product and cart pages when the Payment Request Button Support (PRBS) is disabled in WooCommerce. The checkout page still loads Stripe scripts."
msgstr ""

#: inc/snippets/meta/disable-woocommerce-widgets.meta.php:15
msgid "Disable WooCommerce widgets"
msgstr ""

#: inc/snippets/meta/disable-woocommerce-widgets.meta.php:16
msgid "Unregisters all default WooCommerce widgets. Removes them from the widget administration screen and prevents them from rendering in widget areas."
msgstr ""

#: inc/snippets/meta/disable-wordpress-default-lazy-loading.meta.php:15
msgid "Disable default lazy loading for images"
msgstr ""

#: inc/snippets/meta/disable-wordpress-default-lazy-loading.meta.php:16
msgid "Stops WordPress from adding loading=\"lazy\" to images and iframes. Use only if you rely on a theme, plugin, or CDN for lazy loading, or if you prefer to load all media immediately."
msgstr ""

#: inc/snippets/meta/disable-xmlrpc-rsdlink.meta.php:15
msgid "Disable XML-RPC and RSD link"
msgstr ""

#: inc/snippets/meta/disable-xmlrpc-rsdlink.meta.php:16
msgid "Disables XML-RPC and removes the RSD link from the HTML head. XML-RPC is often targeted by brute-force attacks and can be used in DDoS amplification attacks."
msgstr ""

#: inc/snippets/meta/hide-woocommerce-version.meta.php:15
msgid "Hide WooCommerce version"
msgstr ""

#: inc/snippets/meta/hide-woocommerce-version.meta.php:16
msgid "Removes the WooCommerce version number from HTTP headers and asset URLs. Prevents the version from being visible in page source and enqueued file URLs."
msgstr ""

#: inc/snippets/meta/hide-wordpress-version.meta.php:15
msgid "Hide WordPress version"
msgstr ""

#: inc/snippets/meta/hide-wordpress-version.meta.php:16
msgid "Removes the WordPress version number from the HTML head, RSS feeds, and asset URLs. Prevents the version from being visible in page source and enqueued file URLs."
msgstr ""

#: inc/snippets/meta/limit-post-revisions.meta.php:15
msgid "Limit post revisions to 10"
msgstr ""

#: inc/snippets/meta/limit-post-revisions.meta.php:16
msgid "Limits post revisions to a maximum of 10 per post or page. Older revisions are automatically deleted when new ones are created."
msgstr ""

#: inc/snippets/meta/protect-wp-login.meta.php:15
msgid "Protect login from brute force"
msgstr ""

#: inc/snippets/meta/protect-wp-login.meta.php:16
msgid "Hides detailed login error messages and limits failed login attempts per IP address. After 5 failed attempts, the IP is blocked for 5 minutes."
msgstr ""

#: inc/snippets/meta/protect-wp-login.meta.php:17
msgid "tools"
msgstr ""

#: inc/snippets/meta/remove-gutenberg-unwanted-block-patterns.meta.php:15
msgid "Remove WordPress default block patterns"
msgstr ""

#: inc/snippets/meta/remove-gutenberg-unwanted-block-patterns.meta.php:16
msgid "Stops WordPress from loading remote block patterns and removes the built-in core block patterns from the editor. Reduces the number of patterns displayed in the block inserter."
msgstr ""

#: inc/snippets/meta/remove-help-button.meta.php:15
msgid "Remove Help tab"
msgstr ""

#: inc/snippets/meta/remove-help-button.meta.php:16
msgid "Hides the Help tab on all admin screens. The tab is removed from the screen options area at the top right of each admin page."
msgstr ""

#: inc/snippets/meta/remove-rest-api-link.meta.php:15
msgid "Remove REST API links from page source"
msgstr ""

#: inc/snippets/meta/remove-rest-api-link.meta.php:16
msgid "Removes REST API discovery links from the HTML head section. The REST API itself remains functional; only the link tags that advertise its URL are removed."
msgstr ""

#: inc/snippets/meta/remove-thanks-for-using-wordpress-in-footer.meta.php:15
msgid "Remove \"Thanks for using WordPress\" from footer"
msgstr ""

#: inc/snippets/meta/remove-thanks-for-using-wordpress-in-footer.meta.php:16
msgid "Removes the \"Thanks for using WordPress\" message from the admin footer."
msgstr ""

#: inc/snippets/meta/remove-woocommerce-patterns.meta.php:15
msgid "Remove WooCommerce default block patterns"
msgstr ""

#: inc/snippets/meta/remove-woocommerce-patterns.meta.php:16
msgid "Removes all WooCommerce block patterns from the editor. Reduces the number of patterns displayed in the block inserter."
msgstr ""

#: inc/snippets/meta/remove-wordpress-logo.meta.php:15
msgid "Remove WordPress logo from admin bar"
msgstr ""

#: inc/snippets/meta/remove-wordpress-logo.meta.php:16
msgid "Removes the WordPress logo and its associated menu from the admin bar."
msgstr ""

#: inc/snippets/meta/separate-gutenberg-core-block-styles.meta.php:15
msgid "Load block styles separately"
msgstr ""

#: inc/snippets/meta/separate-gutenberg-core-block-styles.meta.php:16
msgid "Forces WordPress to load core block styles as separate files instead of inlining them. Each block loads only the stylesheet it requires, reducing the CSS payload on pages that use few blocks."
msgstr ""

#: assets/src/js/components/AutoconfigButton.js:32
